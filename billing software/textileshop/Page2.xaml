<Page x:Class="textileshop.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Product Importer"
      Background="#F0F4FF"
      FontFamily="Segoe UI">

    <Page.Resources>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#4F46E5"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3730A3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#C7D2FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#4F46E5"/>
            <Setter Property="BorderBrush"     Value="#C7D2FE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenBtn" TargetType="Button">
            <Setter Property="Background"      Value="#16A34A"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#166534"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LightInput" TargetType="TextBox">
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#1E1B4B"/>
            <Setter Property="BorderBrush"              Value="#C7D2FE"/>
            <Setter Property="BorderThickness"          Value="1.5"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Padding"                  Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment"      Value="Stretch"/>
            <Setter Property="CaretBrush"               Value="#4F46E5"/>
            <Setter Property="SelectionBrush"           Value="#C7D2FE"/>
            <Setter Property="SelectionTextBrush"       Value="#1E1B4B"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin"     Value="0,0,0,5"/>
        </Style>

    </Page.Resources>

    <Grid>
        <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Stretch">

                <!-- TOP ACCENT BAR -->
                <Border Height="6" HorizontalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#4F46E5" Offset="0"/>
                            <GradientStop Color="#7C3AED" Offset="0.5"/>
                            <GradientStop Color="#A855F7" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel Margin="32,28,32,32">

                    <!-- HEADER CARD -->
                    <Border Background="White" CornerRadius="14"
                            Padding="28,22" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#C7D2FE" Opacity="0.5" BlurRadius="16" ShadowDepth="2"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Border Background="#EEF2FF" CornerRadius="20"
                                        Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                    <TextBlock Text="PRODUCT ENTRY" FontSize="9" FontWeight="Bold" Foreground="#4F46E5"/>
                                </Border>
                                <TextBlock Text="Add Products to Inventory"
                                           FontSize="24" FontWeight="Bold" Foreground="#1E1B4B"/>
                                <TextBlock Text="Fill in the product details below and add them to your inventory."
                                           FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="56" Height="56" CornerRadius="14"
                                    Margin="20,0,0,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4F46E5" Offset="0"/>
                                        <GradientStop Color="#7C3AED" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="✏️" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- STATUS BAR -->
                    <Border x:Name="StatusBar" Background="#F5F3FF" CornerRadius="8"
                            Padding="14,10" Margin="0,0,0,20" Visibility="Collapsed">
                        <TextBlock x:Name="TxtStatus" Foreground="#4F46E5" FontSize="13" FontWeight="SemiBold"/>
                    </Border>

                    <!-- ══ PRODUCT ENTRY FORM (directly on page, no modal) ══ -->
                    <Border Background="White" CornerRadius="16" Padding="36,32" Margin="0,0,0,20"
                            BorderBrush="#EEF2FF" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#C7D2FE" Opacity="0.4" BlurRadius="16" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel KeyboardNavigation.TabNavigation="Cycle">

                            <!-- Form Header -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Product Details"
                                           FontSize="20" FontWeight="Bold" Foreground="#1E1B4B"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="+ Add to List"
                                            Style="{StaticResource SecondaryBtn}"
                                            Width="130" Height="40" Margin="0,0,10,0"
                                            Click="BtnModalAddToList_Click"/>
                                    <Button Content="✅ Save All"
                                            Style="{StaticResource PrimaryBtn}"
                                            Width="120" Height="40"
                                            Click="BtnModalSaveAll_Click"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#EEF2FF" Margin="0,0,0,20"/>

                            <!-- Product Name -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="PRODUCT NAME *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtModal_ProductName" Style="{StaticResource LightInput}"
                                         Height="44" TabIndex="1"
                                         KeyDown="TxtModal_Field_KeyDown"/>
                            </StackPanel>

                            <!-- Qty | Sales Rate -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="QUANTITY *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtModal_Qty" Style="{StaticResource LightInput}"
                                             Height="44" Text="1" TabIndex="2"
                                             TextChanged="TxtModal_Calculate_Changed"
                                             KeyDown="TxtModal_Field_KeyDown"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SALES RATE (₹) *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtModal_Rate" Style="{StaticResource LightInput}"
                                             Height="44" TabIndex="3"
                                             TextChanged="TxtModal_Calculate_Changed"
                                             KeyDown="TxtModal_Field_KeyDown"/>
                                </StackPanel>
                            </Grid>

                            <!-- Purchase Price | Net Rate (auto) -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PRODUCTION COST (₹) *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtModal_PurchasePrice" Style="{StaticResource LightInput}"
                                             Height="44" TabIndex="4"
                                             TextChanged="TxtModal_Calculate_Changed"
                                             KeyDown="TxtModal_Field_KeyDown"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="NET RATE (₹)" Style="{StaticResource FieldLabel}" Foreground="#4F46E5"/>
                                    <TextBox x:Name="TxtModal_NetRate" Style="{StaticResource LightInput}"
                                             Height="44" IsReadOnly="True"
                                             Background="#EEF2FF" Foreground="#4F46E5"
                                             FontWeight="Bold" Text="0.00" TabIndex="99"/>
                                </StackPanel>
                            </Grid>

                            <!-- CGST | SGST -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CGST %" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtModal_CGST" Style="{StaticResource LightInput}"
                                             Height="44" Text="0" TabIndex="5"
                                             TextChanged="TxtModal_Calculate_Changed"
                                             KeyDown="TxtModal_Field_KeyDown"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SGST %" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtModal_SGST" Style="{StaticResource LightInput}"
                                             Height="44" Text="0" TabIndex="6"
                                             TextChanged="TxtModal_Calculate_Changed"
                                             KeyDown="TxtModal_LastField_KeyDown"/>
                                </StackPanel>
                            </Grid>

                            <!-- Profit Amount | Profit % (auto) -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PROFIT AMOUNT (₹)" Style="{StaticResource FieldLabel}" Foreground="#16A34A"/>
                                    <TextBox x:Name="TxtModal_ProfitAmount" Style="{StaticResource LightInput}"
                                             Height="44" IsReadOnly="True"
                                             Background="#F0FDF4" Foreground="#16A34A"
                                             FontWeight="Bold" Text="0.00" TabIndex="99"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PROFIT %" Style="{StaticResource FieldLabel}" Foreground="#16A34A"/>
                                    <TextBox x:Name="TxtModal_ProfitPct" Style="{StaticResource LightInput}"
                                             Height="44" IsReadOnly="True"
                                             Background="#F0FDF4" Foreground="#16A34A"
                                             FontWeight="Bold" Text="0.00 %" TabIndex="99"/>
                                </StackPanel>
                            </Grid>

                            <!-- Pending Items -->
                            <Border Background="#FAFAFA" CornerRadius="10" Padding="14"
                                    BorderBrush="#EEF2FF" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Pending Items" FontSize="12" FontWeight="Bold"
                                                   Foreground="#4F46E5" VerticalAlignment="Center"/>
                                        <Border Background="#EEF2FF" CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
                                            <TextBlock x:Name="TxtPendingCount" Text="0"
                                                       FontSize="11" FontWeight="Bold" Foreground="#4F46E5"/>
                                        </Border>
                                    </StackPanel>
                                    <ListBox x:Name="LbPendingItems" Height="100"
                                             Background="Transparent" BorderThickness="0"
                                             HorizontalAlignment="Stretch"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,5">
                                                    <TextBlock FontSize="12" TextWrapping="Wrap">
                                                        <Run Text="{Binding ProductName}" FontWeight="SemiBold" Foreground="#1E1B4B"/>
                                                        <Run Text="  ·  Qty: " Foreground="#9CA3AF"/>
                                                        <Run Text="{Binding Qty}" Foreground="#6B7280"/>
                                                        <Run Text="  ·  Cost: ₹" Foreground="#9CA3AF"/>
                                                        <Run Text="{Binding PurchasePrice, StringFormat=N2}" Foreground="#6B7280"/>
                                                        <Run Text="  ·  Sales: ₹" Foreground="#9CA3AF"/>
                                                        <Run Text="{Binding Rate, StringFormat=N2}" Foreground="#4F46E5" FontWeight="SemiBold"/>
                                                        <Run Text="  ·  Profit: " Foreground="#9CA3AF"/>
                                                        <Run Text="{Binding ProfitPct, StringFormat=N1}" Foreground="#16A34A" FontWeight="SemiBold"/>
                                                        <Run Text="%" Foreground="#16A34A" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <DataGrid x:Name="DgProducts" Visibility="Collapsed"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"/>
    </Grid>
</Page>