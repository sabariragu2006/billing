<Page x:Class="textileshop.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings"
      Background="#F5F3FF"
      FontFamily="Segoe UI">

    <Page.Resources>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="2"
                          Direction="270" Color="#C7D2FE" Opacity="0.4"/>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#7C3AED"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6D28D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5B21B6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#7C3AED"/>
            <Setter Property="BorderBrush"     Value="#DDD6FE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EDE9FE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DDD6FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LightInput" TargetType="TextBox">
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#1E1B4B"/>
            <Setter Property="BorderBrush"              Value="#DDD6FE"/>
            <Setter Property="BorderThickness"          Value="1.5"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Padding"                  Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"               Value="#7C3AED"/>
            <Setter Property="SelectionBrush"           Value="#DDD6FE"/>
            <Setter Property="SelectionTextBrush"       Value="#1E1B4B"/>
        </Style>

    </Page.Resources>

    <!-- ROOT: Grid fills the page, ScrollViewer fills the grid -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="6"/>
            <!-- accent bar -->
            <RowDefinition Height="*"/>
            <!-- scrollable content -->
        </Grid.RowDefinitions>

        <!-- Gradient accent bar -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#7C3AED" Offset="0"/>
                    <GradientStop Color="#A855F7" Offset="0.5"/>
                    <GradientStop Color="#C084FC" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ScrollViewer takes the remaining height -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">

            <StackPanel MaxWidth="720" HorizontalAlignment="Center"
                        Margin="24,28,24,40">

                <!-- ══ HEADER CARD ══ -->
                <Border Padding="24,22" Background="White"
                        CornerRadius="14" Margin="0,0,0,20"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="4" CornerRadius="2"
                                        Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#7C3AED" Offset="0"/>
                                            <GradientStop Color="#A855F7" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border Background="#EDE9FE" CornerRadius="20" Padding="10,4">
                                    <TextBlock Text="SETTINGS" FontSize="9" FontWeight="Bold"
                                               Foreground="#7C3AED"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Application Settings"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="#1E1B4B"/>
                            <TextBlock Text="Customize your shop's appearance and branding"
                                       FontSize="13" Foreground="#9CA3AF"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Width="56" Height="56"
                                CornerRadius="14" Margin="20,0,0,0"
                                VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                    <GradientStop Color="#A855F7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="⚙️" FontSize="26"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ══ SHOP BRANDING CARD ══ -->
                <Border Padding="24,22" Background="White"
                        CornerRadius="14" Margin="0,0,0,16"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel>

                        <!-- Section heading -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border CornerRadius="2" Width="4" Margin="0,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#7C3AED" Offset="0"/>
                                        <GradientStop Color="#A855F7" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="🏪  Shop Branding"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="#1E1B4B" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Shop Name -->
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="SHOP NAME *"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#A78BFA" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtShopName"
                                     Style="{StaticResource LightInput}"
                                     Height="44"
                                     TextChanged="TxtShopName_TextChanged"/>
                            <TextBlock Text="Appears on bills, reports, and the sidebar header"
                                       FontSize="11" Foreground="#9CA3AF" Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- Subtitle -->
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="SUBTITLE / TAGLINE"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#A78BFA" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtSubtitle"
                                     Style="{StaticResource LightInput}"
                                     Height="44"
                                     Text="Inventory Manager"
                                     TextChanged="TxtSubtitle_TextChanged"/>
                            <TextBlock Text="Shown below the shop name in the sidebar"
                                       FontSize="11" Foreground="#9CA3AF" Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- Logo Upload -->
                        <StackPanel>
                            <TextBlock Text="SHOP LOGO"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#A78BFA" Margin="0,0,0,6"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Preview box -->
                                <Border Grid.Column="0"
                                        Background="#F5F3FF"
                                        BorderBrush="#DDD6FE"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        Height="80">
                                    <Grid>
                                        <Image x:Name="ImgLogoPreview"
                                               Stretch="Uniform"
                                               Margin="8"/>
                                        <TextBlock x:Name="TxtLogoPlaceholder"
                                                   Text="🖼️  No logo selected"
                                                   Foreground="#A78BFA"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"/>
                                    </Grid>
                                </Border>

                                <!-- Upload button -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Content="📤  Upload Logo"
                                            Style="{StaticResource SecondaryBtn}"
                                            Width="140" Height="40"
                                            Click="BtnUploadLogo_Click"/>
                                    <Button x:Name="BtnRemoveLogo"
                                            Content="🗑️  Remove"
                                            Style="{StaticResource SecondaryBtn}"
                                            Width="140" Height="34"
                                            Margin="0,8,0,0"
                                            Visibility="Collapsed"
                                            Click="BtnRemoveLogo_Click"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="PNG or JPG recommended · max 200×200 px · under 500 KB"
                                       FontSize="11" Foreground="#9CA3AF" Margin="0,8,0,0"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- ══ LIVE PREVIEW CARD ══ -->
                <Border Padding="24,22" Background="White"
                        CornerRadius="14" Margin="0,0,0,20"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border CornerRadius="2" Width="4" Margin="0,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#7C3AED" Offset="0"/>
                                        <GradientStop Color="#A855F7" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="👁️  Live Preview"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="#1E1B4B" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Sidebar preview mock -->
                        <Border Background="#1E1B4B" CornerRadius="10" Padding="16,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                <!-- Logo box -->
                                <Border Background="#7C3AED" CornerRadius="10"
                                        Width="40" Height="40" Margin="0,0,12,0">
                                    <Grid>
                                        <Image x:Name="ImgPreviewLogo"
                                               Width="32" Height="32"
                                               Stretch="Uniform"/>
                                        <TextBlock x:Name="TxtPreviewLogoFallback"
                                                   Text="🧵" FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Name + subtitle -->
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtPreviewShopName"
                                               Text="Tharun Textiles"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="White"/>
                                    <TextBlock x:Name="TxtPreviewSubtitle"
                                               Text="Inventory Manager"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="#A78BFA"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Live pill -->
                                <Border Background="#7C3AED" CornerRadius="20"
                                        Padding="10,4" Margin="16,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="● LIVE" FontSize="10"
                                               FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="This is how your branding appears in the app sidebar"
                                   FontSize="11" Foreground="#9CA3AF"
                                   Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ══ ACTION BUTTONS ══ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status message (left-aligned) -->
                    <Border Grid.Column="0" Background="#EDE9FE" CornerRadius="8"
                            Padding="14,8" VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                        <TextBlock x:Name="TxtStatus"
                                   Foreground="#7C3AED"
                                   FontSize="12" FontWeight="SemiBold"/>
                    </Border>

                    <Button Grid.Column="1"
                            Content="↺  Reset Defaults"
                            Style="{StaticResource SecondaryBtn}"
                            Width="160" Height="42"
                            Click="BtnReset_Click"/>

                    <Button Grid.Column="3"
                            Content="✅  Save Changes"
                            Style="{StaticResource PrimaryBtn}"
                            Width="160" Height="42"
                            Click="BtnSave_Click"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>