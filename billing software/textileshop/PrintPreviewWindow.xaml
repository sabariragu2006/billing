<Window x:Class="textileshop.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bill Preview" 
        Width="520" Height="700"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Primary button style -->
        <Style x:Key="PreviewBtn" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button style -->
        <Style x:Key="PreviewBtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Preview Area -->
            <RowDefinition Height="Auto"/>
            <!-- Footer Buttons -->
        </Grid.RowDefinitions>

        <!-- ══ HEADER ══ -->
        <Border Grid.Row="0" Padding="16,12" Background="White" 
                BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="🧾 Bill Preview" FontSize="16" FontWeight="Bold" 
                               Foreground="#1E293B"/>
                    <TextBlock x:Name="TxtPreviewInfo" FontSize="11" 
                               Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✕" Width="28" Height="28"
                        Background="Transparent" Foreground="#64748B"
                        BorderThickness="0" FontSize="14" Cursor="Hand"
                        ToolTip="Close preview" Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- ══ BILL PREVIEW AREA ══ -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" 
                BorderThickness="1" CornerRadius="8" Padding="24,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False"
                          PanningMode="VerticalOnly">

                <!-- Bill Content (Monospaced for alignment) -->
                <TextBox x:Name="TxtBillPreview" 
                         FontFamily="Consolas, 'Courier New', monospace"
                         FontSize="10.5" 
                         Foreground="#1E293B" 
                         Background="Transparent"
                         BorderThickness="0"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Hidden"
                         HorizontalScrollBarVisibility="Hidden"
                         Padding="0,0,4,0"/>

            </ScrollViewer>
        </Border>

        <!-- ══ FOOTER ACTIONS ══ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,12,0,0">

            <Button Content="📋 Copy to Clipboard" 
                    Style="{StaticResource PreviewBtnSecondary}"
                    Width="180" Height="44" Margin="0,0,12,0"
                    Click="BtnCopy_Click"/>

            <Button x:Name="BtnPrint"
                    Content="🖨 Print Bill" 
                    Style="{StaticResource PreviewBtn}"
                    Width="140" Height="44"
                    Click="BtnPrint_Click"/>

        </StackPanel>
    </Grid>
</Window>