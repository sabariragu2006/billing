<Window x:Class="textileshop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Textile Inventory"
        Height="760" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F3FF"
        FontFamily="Segoe UI">

    <Window.Resources>

        <DropShadowEffect x:Key="SidebarShadow" BlurRadius="24" ShadowDepth="3"
                          Direction="0" Color="#1A000000" Opacity="0.12"/>
        <DropShadowEffect x:Key="TopBarShadow" BlurRadius="12" ShadowDepth="1"
                          Direction="270" Color="#10000000" Opacity="0.08"/>

        <!-- ═══════════════════════════════════════
             ACTIVE NAV BUTTON
        ═══════════════════════════════════════ -->
        <Style x:Key="NavBtnActive" TargetType="Button">
            <Setter Property="Background"                 Value="#7C3AED"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                    Value="14,11"/>
            <Setter Property="Margin"                     Value="10,2"/>
            <Setter Property="FontSize"                   Value="13"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Grid.ColumnSpan="2"
                                                  VerticalAlignment="Center"/>
                                <Ellipse Grid.Column="2" Width="6" Height="6"
                                         Fill="White" Opacity="0.7"
                                         VerticalAlignment="Center"
                                         Margin="0,0,4,0"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════
             IDLE NAV BUTTON
        ═══════════════════════════════════════ -->
        <Style x:Key="NavBtnIdle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="#6D28D9"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                    Value="14,11"/>
            <Setter Property="Margin"                     Value="10,2"/>
            <Setter Property="FontSize"                   Value="13"/>
            <Setter Property="FontWeight"                 Value="Bold"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EDE9FE"/>
                                <Setter Property="Foreground" Value="#5B21B6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DDD6FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════
             THIN SCROLLBAR for sidebar
        ═══════════════════════════════════════ -->
        <Style x:Key="SidebarScrollBar" TargetType="ScrollBar">
            <Setter Property="Width"      Value="4"/>
            <Setter Property="MinWidth"   Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#DDD6FE" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar Grid.Column="1"
                                       x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource SidebarScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════
             SIDEBAR — fully scrollable
        ══════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="White"
                Effect="{StaticResource SidebarShadow}"
                Panel.ZIndex="10">

            <!-- Single ScrollViewer wrapping everything -->
            <ScrollViewer Style="{StaticResource SidebarScrollViewer}"
                          PanningMode="VerticalOnly">
                <StackPanel>

                    <!-- ── BRANDING BLOCK ── -->
                    <Border Padding="20,24,20,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="0,0,0,10">
                                <Image x:Name="ImgShopLogo"
       MaxWidth="44" MaxHeight="44"
       Stretch="Uniform"
       Visibility="Collapsed"
       Margin="0,0,12,0"/>

                                <Border x:Name="TxtLogoFallbackBox"
                                        Background="#7C3AED" CornerRadius="12"
                                        Width="44" Height="44" Margin="0,0,12,0">
                                    <TextBlock x:Name="TxtLogoFallback"
                                               Text="🧵" FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtShopName"
                                               Text="Tharun Textiles"
                                               Foreground="#1E1B4B"
                                               FontSize="15" FontWeight="Bold"
                                               LineHeight="18"/>
                                    <TextBlock x:Name="TxtShopSubtitle"
                                               Text="Inventory Manager"
                                               Foreground="#7C3AED"
                                               FontSize="10" FontWeight="SemiBold"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Background="#EDE9FE" CornerRadius="20"
                                    Padding="10,4" HorizontalAlignment="Left">
                                <TextBlock Text="● LIVE" FontSize="10" FontWeight="Bold"
                                           Foreground="#7C3AED"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Divider -->
                    <Rectangle Height="1" Fill="#EDE9FE" Margin="16,0"/>

                    <!-- Section label -->
                    <TextBlock Text="MAIN MENU"
                               Foreground="#A78BFA"
                               FontSize="10" FontWeight="Bold"
                               Margin="24,14,0,6"/>

                    <!-- ── NAV BUTTONS ── -->
                    <StackPanel Margin="0,0,0,8">

                        <Button x:Name="BtnDashboard"
                                Style="{StaticResource NavBtnActive}"
                                Click="NavButton_Click" Tag="dashboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="15" VerticalAlignment="Center" Width="24"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnProducts"
                                Style="{StaticResource NavBtnIdle}"
                                Click="NavButton_Click" Tag="products">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="15" VerticalAlignment="Center" Width="24"/>
                                <TextBlock Text="Products" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnImport"
                                Style="{StaticResource NavBtnIdle}"
                                Click="NavButton_Click" Tag="import">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂" FontSize="15" VerticalAlignment="Center" Width="24"/>
                                <TextBlock Text="Add Products" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnImportHistory"
                                Style="{StaticResource NavBtnIdle}"
                                Click="NavButton_Click" Tag="importhistory">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📥" FontSize="15" VerticalAlignment="Center" Width="24"/>
                                <TextBlock Text="Stock Entry History" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnBilling"
                                Style="{StaticResource NavBtnIdle}"
                                Click="NavButton_Click" Tag="billing">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧾" FontSize="15" VerticalAlignment="Center" Width="24"/>
                                <TextBlock Text="Billing" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnHistory"
                                Style="{StaticResource NavBtnIdle}"
                                Click="NavButton_Click" Tag="history">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="15" VerticalAlignment="Center" Width="24"/>
                                <TextBlock Text="Bill History" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnCustomers"
                                Style="{StaticResource NavBtnIdle}"
                                Click="NavButton_Click" Tag="customers">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" FontSize="15" VerticalAlignment="Center" Width="24"/>
                                <TextBlock Text="Customers" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnReturn"
        Style="{StaticResource NavBtnIdle}"
        Click="NavButton_Click"
        Tag="return">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↩️" FontSize="15" VerticalAlignment="Center" Width="24"/>
                                <TextBlock Text="Return" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSalesReport"
                                Style="{StaticResource NavBtnIdle}"
                                Click="NavButton_Click" Tag="sales">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="15" VerticalAlignment="Center" Width="24"/>
                                <TextBlock Text="Sales Report" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        

                        <!-- Divider before settings -->
                        <Rectangle Height="1" Fill="#EDE9FE" Margin="14,8"/>

                        <Button x:Name="BtnSettings"
                                Style="{StaticResource NavBtnIdle}"
                                Click="NavButton_Click" Tag="settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="15" VerticalAlignment="Center" Width="24"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <!-- ── FOOTER ── -->
                    <Border Background="#F5F3FF" Padding="20,12">
                        <StackPanel>
                            <Rectangle Height="1" Fill="#DDD6FE" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#EDE9FE" CornerRadius="6"
                                        Padding="6,3" Margin="0,0,8,0">
                                    <TextBlock Text="v1.0" FontSize="10" FontWeight="Bold"
                                               Foreground="#7C3AED"/>
                                </Border>
                                <TextBlock Text="Textile Shop" Foreground="#A78BFA"
                                           FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══════════════════════════════════════════════
             MAIN CONTENT AREA
        ══════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="#F5F3FF">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── TOP BAR ── -->
            <Border Grid.Row="0" Background="White"
                    Effect="{StaticResource TopBarShadow}"
                    Padding="24,0">
                <Grid Height="58">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="PageIconBubble"
                                Background="#EDE9FE" CornerRadius="10"
                                Width="36" Height="36" Margin="0,0,12,0">
                            <TextBlock x:Name="TxtPageIcon"
                                       Text="🏠" FontSize="17"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtBreadcrumb"
                                       Text="Home"
                                       FontSize="11" Foreground="#A78BFA"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="PageTitle"
                                       Text="Dashboard"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="#1E1B4B"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F5F3FF" CornerRadius="8"
                                Padding="12,7" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🕐" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtClock"
                                           Foreground="#6D28D9"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#7C3AED" CornerRadius="20" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Admin" FontSize="12"
                                           FontWeight="SemiBold" Foreground="White"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── PAGE FRAME ── -->
            <Frame Grid.Row="1"
                   x:Name="MainFrame"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"
                   Navigated="MainFrame_Navigated"/>
        </Grid>
    </Grid>
</Window>
