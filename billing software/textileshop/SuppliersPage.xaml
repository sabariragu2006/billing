<Page x:Class="textileshop.SuppliersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Suppliers Analytics"
      Background="#F5F3FF"
      FontFamily="Segoe UI">

    <Page.Resources>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="2"
                          Direction="270" Color="#C7D2FE" Opacity="0.4"/>
        <DropShadowEffect x:Key="HeaderShadow" BlurRadius="14" ShadowDepth="1"
                          Direction="270" Color="#C7D2FE" Opacity="0.3"/>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#7C3AED"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6D28D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5B21B6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#7C3AED"/>
            <Setter Property="BorderBrush"     Value="#DDD6FE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EDE9FE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DDD6FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Field label style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#A78BFA"/>
            <Setter Property="Margin"     Value="0,0,0,5"/>
        </Style>

        <Style x:Key="LightCombo" TargetType="ComboBox">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#1E1B4B"/>
            <Setter Property="BorderBrush"     Value="#C7D2FE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="Height"          Value="40"/>
        </Style>

        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#F5F3FF"/>
            <Setter Property="Foreground"      Value="#6B7280"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="16,13"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="#EDE9FE"/>
            <Setter Property="Height"          Value="46"/>
        </Style>

        <Style x:Key="GridRow" TargetType="DataGridRow">
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F3FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EDE9FE"/>
                    <Setter Property="Foreground" Value="#1E1B4B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="Padding"          Value="16,0"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#1E1B4B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <Grid Background="#F5F3FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ACCENT BAR -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#7C3AED" Offset="0"/>
                    <GradientStop Color="#A855F7" Offset="0.5"/>
                    <GradientStop Color="#C084FC" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- HEADER -->
        <Border Grid.Row="1" Background="White" Padding="28,20"
                Effect="{StaticResource HeaderShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="4" CornerRadius="2" Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                    <GradientStop Color="#A855F7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Background="#EDE9FE" CornerRadius="20" Padding="10,4">
                            <TextBlock Text="SUPPLIERS" FontSize="9" FontWeight="Bold"
                                       Foreground="#7C3AED"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Supplier Analytics" FontSize="22" FontWeight="Bold"
                               Foreground="#1E1B4B"/>
                    <TextBlock Text="View and manage your suppliers"
                               FontSize="13" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Header action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📄 Template"
                            Style="{StaticResource SecondaryBtn}"
                            Height="40" Margin="0,0,10,0"
                            Click="BtnExportTemplate_Click"/>
                    <Button Content="📥 Import CSV"
                            Style="{StaticResource SecondaryBtn}"
                            Height="40" Margin="0,0,10,0"
                            Click="BtnImportSuppliers_Click"/>
                    <Button Content="↺ Refresh"
                            Style="{StaticResource SecondaryBtn}"
                            Height="40" Margin="0,0,10,0"
                            Click="BtnRefresh_Click"/>
                    <Button Content="📤 Export CSV"
                            Style="{StaticResource SecondaryBtn}"
                            Height="40" Margin="0,0,10,0"
                            Click="BtnExportCsv_Click"/>
                    <Button Content="+ Add Supplier"
                            Style="{StaticResource PrimaryBtn}"
                            Height="40"
                            Click="BtnAddSupplier_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FILTER TOOLBAR -->
        <Border Grid.Row="3" Background="White" CornerRadius="14"
                Effect="{StaticResource CardShadow}" Margin="28,0,28,0"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Grid Grid.Column="0" Width="320" HorizontalAlignment="Left">
                    <Border Background="#F5F3FF" BorderBrush="#DDD6FE"
                            BorderThickness="1.5" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="13"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="#A78BFA"/>
                            <TextBox Grid.Column="1" x:Name="TxtSearch"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#1E1B4B" CaretBrush="#7C3AED"
                                     FontSize="13" Padding="8,10"
                                     VerticalContentAlignment="Center"
                                     TextChanged="TxtSearch_TextChanged"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Search by name or GST number…"
                               Foreground="#C4B5FD" FontSize="13"
                               Margin="38,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Sort -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SORT BY" Foreground="#9CA3AF" FontSize="10"
                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="CmbSort" Style="{StaticResource LightCombo}"
                              Width="200" SelectionChanged="CmbSort_SelectionChanged">
                        <ComboBoxItem Content="Name A → Z"              IsSelected="True"/>
                        <ComboBoxItem Content="Name Z → A"/>
                        <ComboBoxItem Content="Last Import (Newest)"/>
                        <ComboBoxItem Content="Last Import (Oldest)"/>
                        <ComboBoxItem Content="Most Imports"/>
                        <ComboBoxItem Content="Total Items (High → Low)"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DATAGRID -->
        <Border Grid.Row="5" Background="White" Margin="28,0,28,0"
                CornerRadius="14" Effect="{StaticResource CardShadow}"
                ClipToBounds="True">
            <DataGrid x:Name="DgSuppliers"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" Background="White" BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EDE9FE"
                      RowHeight="58" AlternatingRowBackground="#FAFBFF"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      VerticalScrollBarVisibility="Auto"
                      ColumnHeaderStyle="{StaticResource GridHeader}"
                      RowStyle="{StaticResource GridRow}"
                      CellStyle="{StaticResource GridCell}"
                      MouseDoubleClick="DgSuppliers_MouseDoubleClick">

                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="ID" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#EDE9FE" CornerRadius="6" 
                                        Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Id}" FontSize="9"
                                               Width="50" FontWeight="Bold" Foreground="#7C3AED"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="SUPPLIER NAME" Width="2.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="30" Height="34" CornerRadius="17"
                                            Margin="0,0,10,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#7C3AED" Offset="0"/>
                                                <GradientStop Color="#A855F7" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="{Binding Name[0]}" FontSize="13"
                                                   FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                   FontWeight="Bold" Foreground="#1E1B4B"/>
                                        <TextBlock Text="{Binding Contact}" FontSize="11"
                                                   Foreground="#9CA3AF" Margin="0,2,0,0"
                                                   FontFamily="Consolas"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="LAST IMPORT"
                                        Binding="{Binding LastImportDate, StringFormat={}{0:dd MMM yyyy}}"
                                        Width="130"/>

                    <DataGridTemplateColumn Header="IMPORTS" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#F0FDF4" CornerRadius="20"
                                        Padding="10,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding ImportCount}" FontSize="12"
                                               FontWeight="Bold" Foreground="#16A34A"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="TOTAL ITEMS"
                                        Binding="{Binding TotalItemsSupplied, StringFormat={}{0:N0}}"
                                        Width="110"/>

                    <DataGridTemplateColumn Header="ACTIONS" Width="180" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="✎ Edit"
                                            Height="32" Margin="0,0,8,0"
                                            Background="#EDE9FE" Foreground="#7C3AED"
                                            BorderBrush="#DDD6FE" BorderThickness="1"
                                            FontSize="12" FontWeight="SemiBold"
                                            Cursor="Hand" Tag="{Binding}"
                                            Click="BtnEditSupplier_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6" Padding="12,5">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#DDD6FE"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Content="📋 History"
                                            Height="32"
                                            Background="#F5F3FF" Foreground="#6B7280"
                                            BorderBrush="#E5E7EB" BorderThickness="1"
                                            FontSize="12" FontWeight="SemiBold"
                                            Cursor="Hand" Tag="{Binding}"
                                            Click="BtnViewHistory_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6" Padding="12,5">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#EDE9FE"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="6" Background="White" Padding="28,12" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EDE9FE" CornerRadius="6" Padding="10,4">
                        <TextBlock x:Name="TxtStatus" Foreground="#7C3AED"
                                   FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TxtSupplierCount"
                           Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══ ADD / EDIT MODAL OVERLAY ══ -->
        <Grid x:Name="ModalOverlay"
              Grid.Row="0" Grid.RowSpan="7"
              Background="#801E1B4B"
              Visibility="Collapsed"
              Panel.ZIndex="200"
              KeyDown="ModalOverlay_KeyDown">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="60,40">

                <Border Background="White" CornerRadius="16"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="680" MinWidth="520"
                        BorderBrush="#EDE9FE" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#1E1B4B" Opacity="0.22"
                                          BlurRadius="32" ShadowDepth="0"/>
                    </Border.Effect>

                    <StackPanel KeyboardNavigation.TabNavigation="Cycle">

                        <!-- Modal top accent bar -->
                        <Border Height="5" CornerRadius="16,16,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                    <GradientStop Color="#A855F7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <StackPanel Margin="32,24,32,32">

                            <!-- Modal Header -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <!-- Icon + title -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Background="#EDE9FE" CornerRadius="10"
                                                Width="40" Height="40" Margin="0,0,12,0">
                                            <TextBlock x:Name="ModalIcon" Text="🏭"
                                                       FontSize="20"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="ModalTitle"
                                                       Text="Add New Supplier"
                                                       FontSize="19" FontWeight="Bold"
                                                       Foreground="#1E1B4B"/>
                                            <TextBlock Text="Tab · Enter to save · Esc to close"
                                                       FontSize="11" Foreground="#9CA3AF"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action buttons -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="✅  Save"
                                            Style="{StaticResource PrimaryBtn}"
                                            Width="110" Height="40"
                                            Margin="0,0,10,0"
                                            Click="BtnModalSave_Click"/>
                                    <Button Content="✕  Cancel"
                                            Style="{StaticResource SecondaryBtn}"
                                            Width="100" Height="40"
                                            Click="BtnModalCancel_Click"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#EDE9FE" Margin="0,14,0,22"/>

                            <!-- Required fields section -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border CornerRadius="2" Width="4" Margin="0,0,10,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#7C3AED" Offset="0"/>
                                            <GradientStop Color="#A855F7" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="Required Information"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#1E1B4B" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Row 1: Name | GST -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SUPPLIER NAME *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtModal_Name"
                 Height="44" FontSize="13" Padding="12,10"
                 Background="White" Foreground="#1E1B4B"
                 CaretBrush="#7C3AED" BorderBrush="#DDD6FE"
                 BorderThickness="1.5"
                 VerticalContentAlignment="Center"
                 MaxLength="100"
                 TabIndex="1"
                 KeyDown="ModalField_KeyDown"
                 TextChanged="TxtModal_Name_TextChanged"/>
                                    <TextBlock Text="Letters, spaces, - . &amp; ' only. No numbers."
                   FontSize="10" Foreground="#9CA3AF" Margin="2,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="GST NUMBER *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtModal_Contact"
                 Height="44" FontSize="13" Padding="12,10"
                 Background="White" Foreground="#1E1B4B"
                 CaretBrush="#7C3AED" BorderBrush="#DDD6FE"
                 BorderThickness="1.5"
                 VerticalContentAlignment="Center"
                 FontFamily="Consolas"
                 MaxLength="15"
                 TabIndex="2"
                 KeyDown="ModalField_KeyDown"
                 TextChanged="TxtModal_Gst_TextChanged"/>
                                    <TextBlock Text="Exactly 15 chars — e.g. 29ABCDE1234F1Z5"
                   FontSize="10" Foreground="#9CA3AF" Margin="2,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Phone | Email -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PHONE" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtModal_Phone"
                 Height="44" FontSize="13" Padding="12,10"
                 Background="White" Foreground="#1E1B4B"
                 CaretBrush="#7C3AED" BorderBrush="#DDD6FE"
                 BorderThickness="1.5"
                 VerticalContentAlignment="Center"
                 MaxLength="10"
                 TabIndex="3"
                 KeyDown="ModalField_KeyDown"
                 TextChanged="TxtModal_Phone_TextChanged"/>
                                    <TextBlock Text="Exactly 10 digits, no spaces or dashes."
                   FontSize="10" Foreground="#9CA3AF" Margin="2,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtModal_Email"
                 Height="44" FontSize="13" Padding="12,10"
                 Background="White" Foreground="#1E1B4B"
                 CaretBrush="#7C3AED" BorderBrush="#DDD6FE"
                 BorderThickness="1.5"
                 VerticalContentAlignment="Center"
                 MaxLength="100"
                 TabIndex="4"
                 KeyDown="ModalField_KeyDown"/>
                                    <TextBlock Text="e.g. supplier@example.com"
                   FontSize="10" Foreground="#9CA3AF" Margin="2,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 3: Address (full width) -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="ADDRESS" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtModal_Address"
             Height="44" FontSize="13" Padding="12,10"
             Background="White" Foreground="#1E1B4B"
             CaretBrush="#7C3AED" BorderBrush="#DDD6FE"
             BorderThickness="1.5"
             VerticalContentAlignment="Center"
             MaxLength="200"
             TabIndex="5"
             KeyDown="ModalField_KeyDown"/>
                                <TextBlock Text="Max 200 characters."
               FontSize="10" Foreground="#9CA3AF" Margin="2,3,0,0"/>
                            </StackPanel>

                            <!-- Row 4: Notes (full width, multi-line) -->
                            <StackPanel>
                                <TextBlock Text="NOTES" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtModal_Notes"
             Height="80" FontSize="13" Padding="12,10"
             Background="White" Foreground="#1E1B4B"
             CaretBrush="#7C3AED" BorderBrush="#DDD6FE"
             BorderThickness="1.5"
             TextWrapping="Wrap" AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto"
