<!-- ── ReturnsPage.xaml ──────────────────────────────────────────────────── -->
<Page x:Class="textileshop.ReturnsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Returns"
      Background="#F0F4FF"
      FontFamily="Segoe UI">

    <Page.Resources>
        <DropShadowEffect x:Key="CardShadow"   BlurRadius="16" ShadowDepth="2" Direction="270" Color="#C7D2FE" Opacity="0.4"/>
        <DropShadowEffect x:Key="HeaderShadow" BlurRadius="14" ShadowDepth="1" Direction="270" Color="#C7D2FE" Opacity="0.3"/>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#4F46E5"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3730A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#4F46E5"/>
            <Setter Property="BorderBrush"     Value="#C7D2FE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background"      Value="#FEF2F2"/>
            <Setter Property="Foreground"      Value="#DC2626"/>
            <Setter Property="BorderBrush"     Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin"     Value="0,0,0,5"/>
        </Style>

        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#F5F3FF"/>
            <Setter Property="Foreground"      Value="#6B7280"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="#EEF2FF"/>
        </Style>

        <Style x:Key="GridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F3FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEF2FF"/>
                    <Setter Property="Foreground" Value="#1E1B4B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="14,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#1E1B4B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="#F0F4FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ACCENT BAR -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#DC2626" Offset="0"/>
                    <GradientStop Color="#EF4444" Offset="0.5"/>
                    <GradientStop Color="#F87171" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- HEADER -->
        <Border Grid.Row="1" Background="White" Padding="28,18"
                Effect="{StaticResource HeaderShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#FEE2E2" CornerRadius="20" Padding="10,4">
                            <TextBlock Text="RETURNS" FontSize="9" FontWeight="Bold" Foreground="#DC2626"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Return Management" FontSize="22" FontWeight="Bold" Foreground="#1E1B4B"/>
                    <TextBlock Text="Process product returns · stock is automatically restored"
                               FontSize="13" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↻  Refresh" Style="{StaticResource SecondaryBtn}"
                            Height="40" Margin="0,0,10,0" Click="BtnRefresh_Click"/>
                    <Button Content="⬇  Export CSV" Style="{StaticResource SecondaryBtn}"
                            Height="40" Margin="0,0,10,0" Click="BtnExportCsv_Click"/>
                    <Button Content="↩ New Return" Style="{StaticResource PrimaryBtn}"
                            Height="40" Click="BtnNewReturn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPI CARDS -->
        <Grid Grid.Row="3" Margin="28,0,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Returns -->
            <Border Grid.Column="0" Background="White" CornerRadius="14"
                    Effect="{StaticResource CardShadow}" Padding="22,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#FEE2E2" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                            <TextBlock Text="↩" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#DC2626"/>
                        </Border>
                        <TextBlock Text="Total Returns" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="KpiTotalReturns" Text="0"
                               FontSize="36" FontWeight="Bold" Foreground="#DC2626"/>
                    <TextBlock Text="transactions" FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Total Items Returned -->
            <Border Grid.Column="2" Background="White" CornerRadius="14"
                    Effect="{StaticResource CardShadow}" Padding="22,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#FEF3C7" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                            <TextBlock Text="📦" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Items Returned" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="KpiTotalItems" Text="0"
                               FontSize="36" FontWeight="Bold" Foreground="#D97706"/>
                    <TextBlock Text="units back in stock" FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Total Refund Amount -->
            <Border Grid.Column="4" Background="White" CornerRadius="14"
                    Effect="{StaticResource CardShadow}" Padding="22,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#FEE2E2" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                            <TextBlock Text="💸" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Total Refunded" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="KpiTotalRefund" Text="₹ 0.00"
                               FontSize="28" FontWeight="Bold" Foreground="#DC2626"/>
                    <TextBlock Text="amount credited" FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- This Month -->
            <Border Grid.Column="6" Background="White" CornerRadius="14"
                    Effect="{StaticResource CardShadow}" Padding="22,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#EEF2FF" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                            <TextBlock Text="📅" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="This Month" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="KpiThisMonth" Text="₹ 0.00"
                               FontSize="28" FontWeight="Bold" Foreground="#4F46E5"/>
                    <TextBlock Text="refunded this month" FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DATAGRID -->
        <Border Grid.Row="5" Margin="28,0,28,0" CornerRadius="14"
                Background="White" Effect="{StaticResource CardShadow}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table header row with search -->
                <Border Grid.Row="0" Padding="20,14" BorderBrush="#EEF2FF" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="280" HorizontalAlignment="Left">
                            <Border Background="#F5F3FF" BorderBrush="#C7D2FE" BorderThickness="1.5" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="13"
                                               VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#818CF8"/>
                                    <TextBox Grid.Column="1" x:Name="TxtSearch"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="#1E1B4B" CaretBrush="#4F46E5"
                                             FontSize="13" Padding="8,10"
                                             VerticalContentAlignment="Center"
                                             TextChanged="TxtSearch_TextChanged"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="Search by product or customer…"
                                       Foreground="#A5B4FC" FontSize="13"
                                       Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Grid.Column="1" x:Name="TxtShowing"
                                   Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1" x:Name="DgReturns"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" Background="White" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF2FF"
                          RowHeight="54" AlternatingRowBackground="#FAFBFF"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          VerticalScrollBarVisibility="Auto"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          RowStyle="{StaticResource GridRow}"
                          CellStyle="{StaticResource GridCell}">
                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="RETURN ID" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FEE2E2" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Id}" FontSize="10" FontWeight="Bold" Foreground="#DC2626"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="DATE"
                                            Binding="{Binding ReturnDate, StringFormat={}{0:dd MMM yyyy}}"
                                            Width="110"/>

                        <DataGridTemplateColumn Header="PRODUCT" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" Foreground="#1E1B4B"/>
                                        <TextBlock Text="{Binding ProductId, StringFormat='ID: {0}'}"
                                                   FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="QTY" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#EEF2FF" CornerRadius="20" Padding="10,4" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding ReturnQty}" FontWeight="Bold" Foreground="#4F46E5" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="SALE RATE"
                                            Binding="{Binding SaleRate, StringFormat=₹{0:N2}}"
                                            Width="100"/>

                        <DataGridTemplateColumn Header="REFUND AMT" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RefundAmount, StringFormat=₹{0:N2}}"
                                               FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerName}" Width="*"/>

                        <DataGridTemplateColumn Header="REASON" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="20" Padding="10,4" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F3F4F6"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Reason}" Value="Defective">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Reason}" Value="Wrong Item">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Reason}" Value="Size Issue">
                                                        <Setter Property="Background" Value="#EEF2FF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Reason}" Value="Quality Issue">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Reason}" Value="Customer Changed Mind">
                                                        <Setter Property="Background" Value="#F0FDF4"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Reason}" FontSize="11" FontWeight="SemiBold" Foreground="#374151"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ACTION" Width="90" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑" Style="{StaticResource DangerBtn}"
                                            Height="30" Tag="{Binding}" Click="BtnDeleteReturn_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="6" Background="White" Padding="28,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#FEE2E2" CornerRadius="6" Padding="10,4"
                        HorizontalAlignment="Left">
                    <TextBlock x:Name="TxtStatus" Foreground="#DC2626"
                               FontSize="12" FontWeight="SemiBold" Text="Ready"/>
                </Border>
            </Grid>
        </Border>

        <!-- ══ NEW RETURN MODAL ══ -->
        <Grid x:Name="ModalOverlay"
              Grid.Row="0" Grid.RowSpan="7"
              Background="#801E1B4B"
              Visibility="Collapsed"
              Panel.ZIndex="200"
              KeyDown="ModalOverlay_KeyDown">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="60,40">
                <Border Background="White" CornerRadius="16"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="700" MinWidth="520"
                        BorderBrush="#EEF2FF" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#1E1B4B" Opacity="0.22" BlurRadius="32" ShadowDepth="0"/>
                    </Border.Effect>

                    <StackPanel KeyboardNavigation.TabNavigation="Cycle">

                        <!-- Modal accent bar -->
                        <Border Height="5" CornerRadius="16,16,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#DC2626" Offset="0"/>
                                    <GradientStop Color="#F87171" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <StackPanel Margin="32,24,32,32">

                            <!-- Modal Header -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Background="#FEE2E2" CornerRadius="10"
                                                Width="40" Height="40" Margin="0,0,12,0">
                                            <TextBlock Text="↩" FontSize="22" FontWeight="Bold"
                                                       Foreground="#DC2626"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Process Return"
                                                       FontSize="19" FontWeight="Bold" Foreground="#1E1B4B"/>
                                            <TextBlock Text="Stock will be automatically restored on save"
                                                       FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="✅ Save Return" Style="{StaticResource PrimaryBtn}"
                                            Width="130" Height="40" Margin="0,0,10,0"
                                            Background="#DC2626"
                                            Click="BtnSaveReturn_Click"/>
                                    <Button Content="✕ Cancel" Style="{StaticResource SecondaryBtn}"
                                            Width="90" Height="40" Click="BtnCancelReturn_Click"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#EEF2FF" Margin="0,14,0,22"/>

                            <!-- Product picker -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="PRODUCT *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbProduct"
                                          Height="44" FontSize="13"
                                          Background="White" Foreground="#1E1B4B"
                                          BorderBrush="#C7D2FE" BorderThickness="1.5"
                                          IsEditable="True" TabIndex="1"
                                          Text="Search and select product…"
                                          SelectionChanged="CmbProduct_SelectionChanged"/>
                                <TextBlock x:Name="TxtProductInfo"
                                           Text="Select a product to see current stock and rate"
                                           FontSize="11" Foreground="#9CA3AF" Margin="2,4,0,0"/>
                            </StackPanel>

                            <!-- Return Qty | Sale Rate -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="RETURN QTY *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtReturnQty"
                                             Height="44" FontSize="13" Padding="12,10"
                                             Background="White" Foreground="#1E1B4B"
                                             CaretBrush="#4F46E5" BorderBrush="#C7D2FE"
                                             BorderThickness="1.5" VerticalContentAlignment="Center"
                                             TabIndex="2" Text="1"
                                             TextChanged="TxtReturnQty_TextChanged"/>
                                    <TextBlock Text="Units to return to stock"
                                               FontSize="10" Foreground="#9CA3AF" Margin="2,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SALE RATE (₹) *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtSaleRate"
                                             Height="44" FontSize="13" Padding="12,10"
                                             Background="White" Foreground="#1E1B4B"
                                             CaretBrush="#4F46E5" BorderBrush="#C7D2FE"
                                             BorderThickness="1.5" VerticalContentAlignment="Center"
                                             TabIndex="3"
                                             TextChanged="TxtSaleRate_TextChanged"/>
                                    <TextBlock Text="Rate at which it was originally sold"
                                               FontSize="10" Foreground="#9CA3AF" Margin="2,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Refund Amount (auto) -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="REFUND AMOUNT (₹)  —  auto" Style="{StaticResource FieldLabel}" Foreground="#DC2626"/>
                                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.5" CornerRadius="4" Height="44">
                                    <TextBlock x:Name="TxtRefundAmount"
                                               Text="₹ 0.00"
                                               FontSize="16" FontWeight="Bold" Foreground="#DC2626"
                                               VerticalAlignment="Center" Margin="12,0"/>
                                </Border>
                                <TextBlock Text="Qty × Sale Rate — will be deducted from sales"
                                           FontSize="10" Foreground="#9CA3AF" Margin="2,3,0,0"/>
                            </StackPanel>

                            <!-- Customer Name | Reason -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CUSTOMER NAME" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtCustomerName"
                                             Height="44" FontSize="13" Padding="12,10"
                                             Background="White" Foreground="#1E1B4B"
                                             CaretBrush="#4F46E5" BorderBrush="#C7D2FE"
                                             BorderThickness="1.5" VerticalContentAlignment="Center"
                                             MaxLength="100" TabIndex="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="REASON *" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CmbReason"
                                              Height="44" FontSize="13"
                                              Background="White" Foreground="#1E1B4B"
                                              BorderBrush="#C7D2FE" BorderThickness="1.5"
                                              TabIndex="5">
                                        <ComboBoxItem Content="Defective" IsSelected="True"/>
                                        <ComboBoxItem Content="Wrong Item"/>
                                        <ComboBoxItem Content="Size Issue"/>
                                        <ComboBoxItem Content="Quality Issue"/>
                                        <ComboBoxItem Content="Customer Changed Mind"/>
                                        <ComboBoxItem Content="Duplicate Order"/>
                                        <ComboBoxItem Content="Other"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Notes -->
                            <StackPanel>
                                <TextBlock Text="NOTES" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtNotes"
                                         Height="70" FontSize="13" Padding="12,10"
                                         Background="White" Foreground="#1E1B4B"
                                         CaretBrush="#4F46E5" BorderBrush="#C7D2FE"
                                         BorderThickness="1.5"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         MaxLength="500" TabIndex="6"/>
                            </StackPanel>

                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

    </Grid>
</Page>