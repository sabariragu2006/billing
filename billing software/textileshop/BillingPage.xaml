<Page x:Class="textileshop.BillingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="1200"
      Background="#F0F4F8"
      FontFamily="Segoe UI"
      Title="Billing">

    <Page.Resources>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2"
                          Direction="270" Color="#0D000000" Opacity="0.08"/>

        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SECONDARY BUTTON -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F9FAFB"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SUCCESS BUTTON -->
        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#166534"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DANGER BUTTON -->
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FIELD LABEL -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <!-- COMBOBOX STYLE -->
        <Style x:Key="BillingCombo" TargetType="ComboBox">
            <Setter Property="Background"            Value="White"/>
            <Setter Property="Foreground"            Value="#111827"/>
            <Setter Property="BorderBrush"           Value="#D1D5DB"/>
            <Setter Property="BorderThickness"       Value="1"/>
            <Setter Property="FontSize"              Value="13"/>
            <Setter Property="FontFamily"            Value="Segoe UI"/>
            <Setter Property="Padding"               Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- SECTION TITLE -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- DATAGRID HEADER -->
        <Style x:Key="CartGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
        </Style>

        <!-- DATAGRID ROW -->
        <Style x:Key="CartGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F7FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DATAGRID CELL -->
        <Style x:Key="CartGridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#1E293B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <Grid Background="#F0F4F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Top header bar -->
            <RowDefinition Height="12"/>
            <!-- 1: spacer -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Bill meta strip -->
            <RowDefinition Height="12"/>
            <!-- 3: spacer -->
            <RowDefinition Height="*"/>
            <!-- 4: Main content -->
            <RowDefinition Height="Auto"/>
            <!-- 5: Bottom action bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════
             ROW 0 — TOP HEADER BAR
        ══════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White" Padding="28,16"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" CornerRadius="2" Background="#2563EB" Margin="0,0,14,0"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Billing" FontSize="12" Foreground="#9CA3AF"/>
                            <TextBlock Text=" / " FontSize="12" Foreground="#D1D5DB"/>
                            <TextBlock Text="New Bill" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#2563EB"/>
                        </StackPanel>
                        <TextBlock Text="Create New Bill" FontSize="22" FontWeight="Bold"
                                   Foreground="#111827" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EFF6FF" CornerRadius="8" Padding="14,8" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Bill #" Foreground="#6B7280" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtBillNumber" Foreground="#2563EB"
                                       FontSize="12" FontWeight="Bold" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F0FDF4" CornerRadius="8" Padding="14,8">
                        <TextBlock x:Name="TxtBillDate" Foreground="#16A34A"
                                   FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════
             ROW 2 — CUSTOMER INFO STRIP
        ══════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="White" CornerRadius="14"
                Effect="{StaticResource CardShadow}" Margin="28,0,28,0" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <!-- Icon + Label -->
                <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="8"
                        Width="40" Height="40" VerticalAlignment="Center">
                    <TextBlock Text="👤" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Customer Name -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="CUSTOMER NAME" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CmbCustomerName"
              Height="40"
              IsEditable="True"
              StaysOpenOnEdit="True"
              IsTextSearchEnabled="False"
              Background="White"
              Foreground="#111827"
              BorderBrush="#D1D5DB"
              BorderThickness="1"
              FontSize="13"
              Padding="12,8"
              VerticalContentAlignment="Center"
              Loaded="CmbCustomerName_Loaded"
              SelectionChanged="CmbCustomerName_SelectionChanged"/>
                </StackPanel>
                <!-- Mobile icon -->
                <Border Grid.Column="4" Background="#F0FDF4" CornerRadius="8"
                        Width="40" Height="40" VerticalAlignment="Bottom" Margin="0,0,0,0">
                    <TextBlock Text="📱" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Mobile Number -->
                <StackPanel Grid.Column="6" VerticalAlignment="Center">
                    <TextBlock Text="MOBILE NUMBER" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CmbCustomerMobile"
              Height="40"
              IsEditable="True"
              StaysOpenOnEdit="True"
              IsTextSearchEnabled="False"
              PreviewTextInput="TxtCustomerMobile_PreviewTextInput"
              Background="White"
              Foreground="#111827"
              BorderBrush="#D1D5DB"
              BorderThickness="1"
              FontSize="13"
              Padding="12,8"
              VerticalContentAlignment="Center"
              Loaded="CmbCustomerMobile_Loaded"
              SelectionChanged="CmbCustomerMobile_SelectionChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════
             ROW 4 — MAIN CONTENT (Left Panel + Cart)
        ══════════════════════════════════════════ -->
        <Grid Grid.Row="4" Margin="28,0,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: ADD PRODUCT PANEL ── -->
            <Border Grid.Column="0" Background="White" CornerRadius="14"
                    Effect="{StaticResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,20">
                    <StackPanel>

                        <!-- Panel header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Background="#EFF6FF" CornerRadius="7"
                                    Width="32" Height="32" Margin="0,0,10,0">
                                <TextBlock Text="➕" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Add Product" Style="{StaticResource SectionTitle}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Search Product -->
                        <TextBlock Text="SEARCH PRODUCT" Style="{StaticResource FieldLabel}"/>
                        <!-- Search Product -->
                        <ComboBox x:Name="CmbProducts"
          Style="{StaticResource BillingCombo}"
          Height="42"
          IsEditable="True"
          IsTextSearchEnabled="True"
          TextSearch.TextPath="."
          SelectionChanged="CmbProducts_SelectionChanged"
          DropDownOpened="CmbProducts_DropDownOpened"
          KeyDown="CmbProducts_KeyDown"
          MaxDropDownHeight="220"
          StaysOpenOnEdit="True"
          Margin="0,0,0,14"
          Background="White"
          Foreground="#111827"
          BorderBrush="#D1D5DB"
          BorderThickness="1"
          FontSize="13">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>

                        

                        <!-- Rate + Qty side by side -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Rate -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="RATE (₹)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtRate"
                                         Height="42"
                                         IsReadOnly="True"
                                         Background="#F8FAFC"
                                         Foreground="#374151"
                                         BorderBrush="#D1D5DB"
                                         BorderThickness="1"
                                         FontSize="13"
                                         Padding="12,8"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- Quantity -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="QUANTITY" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtQuantity"
Height="42"
Text="1"
PreviewTextInput="TxtQuantity_PreviewTextInput"
TextChanged="TxtQuantity_TextChanged"
KeyDown="TxtQuantity_KeyDown"
Background="White"
Foreground="#111827"
BorderBrush="#D1D5DB"
BorderThickness="1"
FontSize="13"
Padding="12,8"
VerticalContentAlignment="Center"
CaretBrush="#2563EB"/>
                            </StackPanel>
                        </Grid>

                        <!-- Line Total display -->
                        <Border Background="#F0FDF4" CornerRadius="10"
                                BorderBrush="#BBF7D0" BorderThickness="1"
                                Padding="16,12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="LINE TOTAL" FontSize="10" FontWeight="Bold"
                                               Foreground="#6B7280" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtLineTotal" Text="₹ 0.00"
                                               FontSize="22" FontWeight="Bold" Foreground="#16A34A"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="6"
                                        Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="preview" FontSize="10"
                                               FontWeight="Bold" Foreground="#166534"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Stock warning -->
                        <Border x:Name="StockWarnBorder" Background="#FEF2F2" CornerRadius="8"
                                BorderBrush="#FECACA" BorderThickness="1"
                                Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠ " Foreground="#DC2626" FontSize="12"/>
                                <TextBlock x:Name="TxtStockWarning" Foreground="#DC2626"
                                           FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Add to Bill button -->
                        <Button Content="➕   Add to Bill"
                                Style="{StaticResource PrimaryBtn}"
                                Height="44" FontSize="14"
                                Click="BtnAddToBill_Click"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── RIGHT: CART PANEL ── -->
            <Border Grid.Column="2" Background="White" CornerRadius="14"
                    Effect="{StaticResource CardShadow}">
                <Grid Margin="22,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cart header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Background="#FFFBEB" CornerRadius="7"
                                Width="32" Height="32" Margin="0,0,10,0">
                            <TextBlock Text="🛒" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Bill Items" Style="{StaticResource SectionTitle}"
                                   Margin="0,6,0,0"/>
                        <!-- Item count badge -->
                        <Border x:Name="ItemCountBadge" Background="#2563EB" CornerRadius="10"
                                Padding="8,2" Margin="8,6,0,0" VerticalAlignment="Top">
                            <TextBlock x:Name="TxtItemCount" Text="0"
                                       FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>

                    <!-- Cart DataGrid -->
                    <DataGrid Grid.Row="1" x:Name="DgBillItems"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              Background="White"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F3F4F6"
                              RowHeight="48"
                              AlternatingRowBackground="#FAFAFA"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              ColumnHeaderStyle="{StaticResource CartGridHeader}"
                              RowStyle="{StaticResource CartGridRow}"
                              CellStyle="{StaticResource CartGridCell}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PRODUCT NAME"
                                                Binding="{Binding ProductName}" Width="2.5*"/>
                            <DataGridTextColumn Header="RATE"
                                                Binding="{Binding Rate, StringFormat=₹{0:N2}}" Width="*"/>
                            <DataGridTextColumn Header="QTY"
                                                Binding="{Binding Quantity}" Width="60"/>
                            <DataGridTemplateColumn Header="SUBTOTAL" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SubTotal, StringFormat=₹{0:N2}}"
                                                   FontWeight="SemiBold" Foreground="#16A34A"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Width="28" Height="28"
                                                Style="{StaticResource DangerBtn}"
                                                FontSize="11" Cursor="Hand"
                                                ToolTip="Remove item"
                                                Tag="{Binding}"
                                                Click="BtnRemoveItem_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty cart placeholder -->
                    <Border Grid.Row="1" x:Name="EmptyCartPlaceholder"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🛒" FontSize="48"
                                       HorizontalAlignment="Center" Opacity="0.25"/>
                            <TextBlock Text="No items added yet" FontSize="14"
                                       Foreground="#9CA3AF" HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Totals strip at bottom of cart -->
                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="10"
                            BorderBrush="#E5E7EB" BorderThickness="1"
                            Padding="16,14" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Subtotal -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="SUBTOTAL" FontSize="10" FontWeight="Bold"
                                           Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtSubTotal" Text="₹ 0.00"
                                           FontSize="15" FontWeight="Bold" Foreground="#374151"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- CGST -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="CGST" FontSize="10" FontWeight="Bold"
                                           Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtCGST" Text="₹ 0.00"
                                           FontSize="15" FontWeight="Bold" Foreground="#374151"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- SGST -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="SGST" FontSize="10" FontWeight="Bold"
                                           Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtSGST" Text="₹ 0.00"
                                           FontSize="15" FontWeight="Bold" Foreground="#374151"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Separator -->
                            <Rectangle Grid.Column="3" Width="1" Fill="#D1D5DB"
                                       VerticalAlignment="Stretch"/>

                            <!-- Grand Total -->
                            <StackPanel Grid.Column="4" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="GRAND TOTAL" FontSize="10" FontWeight="Bold"
                                           Foreground="#9CA3AF"/>
                                <TextBlock x:Name="TxtGrandTotal" Text="₹ 0.00"
                                           FontSize="24" FontWeight="Bold" Foreground="#2563EB"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════
             ROW 5 — BOTTOM ACTION BAR
        ══════════════════════════════════════════ -->
        <Border Grid.Row="5" Background="White" Padding="28,14"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F0F4F8" CornerRadius="6" Padding="12,5">
                        <TextBlock x:Name="TxtBillStatus"
                                   Text="Ready to bill"
                                   Foreground="#6B7280" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Right: action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🗑  Clear Bill"
                            Style="{StaticResource SecondaryBtn}"
                            Width="130" Height="42"
                            Margin="0,0,10,0"
                            Click="BtnClearBill_Click"/>
                    <Button Content="🖨  Print Bill"
                            Style="{StaticResource SecondaryBtn}"
                            Width="130" Height="42"
                            Margin="0,0,10,0"
                            Click="BtnPrintBill_Click"/>
                    <Button Content="💾  Save &amp; New"
                            Style="{StaticResource SuccessBtn}"
                            Width="150" Height="42"
