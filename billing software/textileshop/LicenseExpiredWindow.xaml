<Window x:Class="textileshop.LicenseExpiredWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License Status"
        Width="560" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Border Background="White" CornerRadius="20" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="6"
                              Color="#000000" Opacity="0.22"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="180"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ HERO BANNER ═══ -->
            <Border x:Name="HeroBanner" Grid.Row="0"
                    CornerRadius="20,20,0,0"
                    Background="#7C3AED">
                <Grid>
                    <!-- Decorative circles -->
                    <Ellipse Width="200" Height="200"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,-60,-60,0"
                             Opacity="0.12">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="White"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="130" Height="130"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Bottom"
                             Margin="-40,0,0,20"
                             Opacity="0.08">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="White"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="80" Height="80"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Margin="0,0,60,-20"
                             Opacity="0.10">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="White"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Hero content -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <!-- Icon with outer ring -->
                        <Grid HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Ellipse x:Name="OuterRing"
                                     Width="84" Height="84"
                                     Opacity="0.25">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="White"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Border x:Name="IconCircle"
                                    Width="64" Height="64"
                                    CornerRadius="32"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="#FFFFFF" Opacity="0.2"/>
                                </Border.Background>
                                <TextBlock x:Name="TxtIcon"
                                           Text="🔒"
                                           FontSize="30"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="TxtTitle"
                                   Text="License Expired"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>

                        <!-- Days badge -->
                        <Border x:Name="BadgePanel"
                                HorizontalAlignment="Center"
                                CornerRadius="20" Padding="14,5"
                                Visibility="Collapsed">
                            <Border.Background>
                                <SolidColorBrush Color="#FFFFFF" Opacity="0.2"/>
                            </Border.Background>
                            <TextBlock x:Name="TxtDaysLeft"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>

                        <!-- Expired chip -->
                        <Border x:Name="StatusChip"
                                HorizontalAlignment="Center"
                                Background="#DC2626"
                                CornerRadius="20" Padding="14,5"
                                Visibility="Visible">
                            <TextBlock x:Name="TxtStatusChip"
                                       Text="● ACCESS BLOCKED"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="White"
                                       />
                        </Border>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ BODY ═══ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,24,32,32">

                    <!-- Description -->
                    <TextBlock x:Name="TxtDescription"
                               FontSize="13" Foreground="#6B7280"
                               TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>

                    <!-- ── Timeline ── -->
                    <Border Background="#F9FAFB" CornerRadius="12"
                            Padding="20,16" Margin="0,0,0,20"
                            BorderBrush="#E5E7EB" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Activated -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <Border Background="#DCFCE7" CornerRadius="8"
                                        Width="36" Height="36"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="✓" FontSize="16" FontWeight="Bold"
                                               Foreground="#16A34A"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="ACTIVATED"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="#9CA3AF"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtActivatedDate"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#111827"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Divider line -->
                            <Rectangle Grid.Column="1" Width="1"
                                       Fill="#E5E7EB" VerticalAlignment="Stretch"/>

                            <!-- Expired / Expiry -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <Border x:Name="ExpiryIcon"
                                        Background="#FEE2E2" CornerRadius="8"
                                        Width="36" Height="36"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtExpiryIcon"
                                               Text="✕" FontSize="16" FontWeight="Bold"
                                               Foreground="#DC2626"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtExpiryLabel"
                                           Text="EXPIRED"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="#9CA3AF"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtExpiryDate"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#111827"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── DB Path box ── -->
                    <Border x:Name="InfoBox"
                            CornerRadius="12" Padding="16,14"
                            Margin="0,0,0,20"
                            BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border x:Name="InfoIconBadge"
                                        CornerRadius="6" Width="28" Height="28"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="📁" FontSize="14"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtInfoTitle"
                                           Text="Your data is safe"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- DB path + copy button -->
                            <Border Background="White" CornerRadius="8"
                                    BorderBrush="#E5E7EB" BorderThickness="1"
                                    Padding="10,8" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtDbPath"
                                               Grid.Column="0"
                                               FontSize="10" Foreground="#6B7280"
                                               TextWrapping="Wrap"
                                               FontFamily="Consolas"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            x:Name="BtnCopy"
                                            Content="Copy"
                                            Width="52" Height="28"
                                            Margin="8,0,0,0"
                                            Cursor="Hand"
                                            Click="BtnCopy_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CopyBd"
                                                        CornerRadius="6"
                                                        Background="#F3F4F6"
                                                        BorderBrush="#E5E7EB"
                                                        BorderThickness="1"
                                                        Padding="6,4">
                                                    <TextBlock x:Name="CopyLabel"
                                                               Text="Copy"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="#374151"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CopyBd" Property="Background" Value="#E5E7EB"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="TxtInfoSub"
                                       FontSize="11" Foreground="#6B7280"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Buttons ── -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="SpacerCol" Width="0"/>
                            <ColumnDefinition x:Name="ContinueCol" Width="0"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="BtnClose"
                                Content="Close Application"
                                Height="44" Cursor="Hand"
                                Click="BtnClose_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="10" Padding="12,8"
                                            Background="#DC2626">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <TextBlock Text="✕ " FontSize="13"
                                                       FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="Close Application"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#B91C1C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="2" x:Name="BtnContinue"
                                Content="Continue for Now"
                                Height="44" Cursor="Hand"
                                Visibility="Collapsed"
                                Click="BtnContinue_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="10"
                                            BorderBrush="#D97706" BorderThickness="1.5"
                                            Background="White" Padding="12,8">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <TextBlock Text="→ " FontSize="13"
                                                       FontWeight="Bold" Foreground="#92400E"/>
                                            <TextBlock Text="Continue for Now"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#92400E"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFFBEB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>