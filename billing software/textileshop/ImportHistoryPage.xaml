<!-- ImportHistoryPage.xaml — White/Violet Theme -->
<Page x:Class="textileshop.ImportHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Import History"
      Background="#F0F4FF"
      FontFamily="Segoe UI">

    <Page.Resources>

        <!-- SHADOWS -->
        <DropShadowEffect x:Key="CardShadow"   BlurRadius="16" ShadowDepth="2"
                          Direction="270" Color="#C7D2FE" Opacity="0.4"/>
        <DropShadowEffect x:Key="HeaderShadow" BlurRadius="14" ShadowDepth="1"
                          Direction="270" Color="#C7D2FE" Opacity="0.35"/>

        <!-- Primary Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#4F46E5"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3730A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#4F46E5"/>
            <Setter Property="BorderBrush"     Value="#C7D2FE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="LightInput" TargetType="TextBox">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#1E1B4B"/>
            <Setter Property="BorderBrush"     Value="#C7D2FE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="LightCombo" TargetType="ComboBox">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#1E1B4B"/>
            <Setter Property="BorderBrush"     Value="#C7D2FE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight"       Value="40"/>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="6"/>
            <!-- Accent bar  -->
            <RowDefinition Height="Auto"/>
            <!-- Header      -->
            <RowDefinition Height="Auto"/>
            <!-- Filters     -->
            <RowDefinition Height="*"/>
            <!-- DataGrid    -->
            <RowDefinition Height="Auto"/>
            <!-- Footer      -->
        </Grid.RowDefinitions>

        <!-- ══ TOP ACCENT BAR ══ -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#4F46E5" Offset="0"/>
                    <GradientStop Color="#7C3AED" Offset="0.5"/>
                    <GradientStop Color="#A855F7" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ══ HEADER ══ -->
        <Border Grid.Row="1" Background="White" Padding="28,22"
                Effect="{StaticResource HeaderShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <!-- Violet tick -->
                        <Border Width="3" Height="16" CornerRadius="2"
                                Margin="0,0,10,0" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#4F46E5" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Background="#EEF2FF" CornerRadius="20" Padding="10,4">
                            <TextBlock Text="IMPORT HISTORY" FontSize="9" FontWeight="Bold"
                                       Foreground="#4F46E5"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Purchase Records"
                               FontSize="24" FontWeight="Bold"
                               Foreground="#1E1B4B"/>
                    <TextBlock Text="View and manage all your Excel import records"
                               FontSize="13" Foreground="#6B7280"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Decorative icon -->
                <Border Grid.Column="1" Width="56" Height="56"
                        CornerRadius="14" Margin="20,0,0,0"
                        VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4F46E5" Offset="0"/>
                            <GradientStop Color="#7C3AED" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="🗂️" FontSize="26"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- ══ FILTERS & ACTIONS ══ -->
        <Border Grid.Row="2" Background="White" Padding="28,16"
                BorderBrush="#EEF2FF" BorderThickness="0,1,0,1"
                Margin="0,12,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#C7D2FE" Opacity="0.25" BlurRadius="10" ShadowDepth="1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Grid Grid.Column="0">
                    <Border Background="#F5F3FF" BorderBrush="#C7D2FE"
                            BorderThickness="1.5" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="13"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="#818CF8"/>
                            <TextBox Grid.Column="1"
                                     x:Name="TxtSearch"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#1E1B4B"
                                     CaretBrush="#4F46E5"
                                     FontSize="13"
                                     Padding="8,10"
                                     VerticalContentAlignment="Center"
                                     Height="40"
                                     TextChanged="TxtSearch_TextChanged"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="🔍 Search by file, supplier, or date…"
                               Foreground="#A5B4FC" FontSize="13"
                               Margin="38,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Date Filter Dropdown -->
                <ComboBox x:Name="CmbDateFilter"
                          Grid.Column="2"
                          Style="{StaticResource LightCombo}"
                          SelectionChanged="CmbDateFilter_SelectionChanged">
                    <ComboBoxItem Content="All Time"        IsSelected="True"/>
                    <ComboBoxItem Content="Today"/>
                    <ComboBoxItem Content="Last 7 Days"/>
                    <ComboBoxItem Content="This Month"/>
                    <ComboBoxItem Content="Last 3 Months"/>
                </ComboBox>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Content="↺ Refresh"
                            Style="{StaticResource SecondaryBtn}"
                            Width="110" Height="40"
                            Margin="0,0,12,0"
                            Click="BtnRefresh_Click"/>

                    <Button Content="📤 Export CSV"
                            Style="{StaticResource PrimaryBtn}"
                            Width="130" Height="40"
                            Click="BtnExportCsv_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ DATA GRID ══ -->
        <Border Grid.Row="3" Background="White" Margin="28,16,28,0"
                CornerRadius="14" Effect="{StaticResource CardShadow}"
                ClipToBounds="True">
            <DataGrid x:Name="DgImportHistory"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      Background="White"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEF2FF"
                      RowHeight="52"
                      AlternatingRowBackground="#FAFBFF"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      VerticalScrollBarVisibility="Auto"
                      MouseDoubleClick="DgImportHistory_MouseDoubleClick">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"      Value="#F5F3FF"/>
                        <Setter Property="Foreground"      Value="#6B7280"/>
                        <Setter Property="FontWeight"      Value="Bold"/>
                        <Setter Property="FontSize"        Value="11"/>
                        <Setter Property="Padding"         Value="16,12"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush"     Value="#EEF2FF"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F3FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EEF2FF"/>
                                <Setter Property="Foreground" Value="#1E1B4B"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness"  Value="0"/>
                        <Setter Property="Padding"          Value="14,0"/>
                        <Setter Property="Foreground"       Value="#374151"/>
                        <Setter Property="FontSize"         Value="13"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#1E1B4B"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Import Date"
                                        Binding="{Binding ImportDate, StringFormat='{}{0:dd MMM yyyy, hh:mm tt}'}"
                                        Width="180"/>

                    <DataGridTextColumn Header="File Name"
                                        Binding="{Binding FileName}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Supplier"
                                        Binding="{Binding SupplierName}"
                                        Width="1.5*"/>

                    <DataGridTextColumn Header="GST Number"
                                        Binding="{Binding SupplierContact}"
                                        Width="1.2*"/>

                    <DataGridTextColumn Header="Items Imported"
                                        Binding="{Binding ItemCount, StringFormat={}{0:N0}}"
                                        Width="120"/>

                    <DataGridTemplateColumn Header="" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="📋 View Details"
                    Height="32"
                    Padding="10,0"
                    Background="#EEF2FF" Foreground="#4F46E5"
                    BorderBrush="#C7D2FE" BorderThickness="1.5"
                    FontSize="11" FontWeight="SemiBold"
                    Cursor="Hand"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ToolTip="View import details"
                    Tag="{Binding}" Click="BtnViewDetails_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══ FOOTER ══ -->
        <Border Grid.Row="4" Padding="28,12" Background="White"
                BorderBrush="#EEF2FF" BorderThickness="0,1,0,0"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EEF2FF" CornerRadius="6" Padding="10,4">
                        <TextBlock x:Name="TxtStatus"
                                   Foreground="#4F46E5" FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="TxtRecordCount"
                           Grid.Column="1"
                           Foreground="#9CA3AF" FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
