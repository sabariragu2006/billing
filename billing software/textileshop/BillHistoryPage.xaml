<Page x:Class="textileshop.BillHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Background="#F0F4F8"
      FontFamily="Segoe UI"
      Title="Bill History">

    <Page.Resources>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2"
                          Direction="270" Color="#0D000000" Opacity="0.08"/>

        <!-- PRIMARY BUTTON -->
        <Style x:Key="HistoryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#2563EB"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SECONDARY BUTTON -->
        <Style x:Key="HistoryBtnSecondary" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#374151"/>
            <Setter Property="BorderBrush"     Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#F9FAFB"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DANGER SECONDARY BUTTON -->
        <Style x:Key="DangerBtnSecondary" TargetType="Button">
            <Setter Property="Background"      Value="#FEF2F2"/>
            <Setter Property="Foreground"      Value="#DC2626"/>
            <Setter Property="BorderBrush"     Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SUCCESS BUTTON -->
        <Style x:Key="SuccessBtn" TargetType="Button">
            <Setter Property="Background"      Value="#16A34A"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#166534"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GRID HEADER -->
        <Style x:Key="HistoryGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#F8FAFC"/>
            <Setter Property="Foreground"      Value="#6B7280"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="#E5E7EB"/>
        </Style>

        <!-- GRID ROW -->
        <Style x:Key="HistoryGridRow" TargetType="DataGridRow">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="#374151"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F7FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1E293B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- GRID CELL -->
        <Style x:Key="HistoryGridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="14,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#1E293B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <Grid Background="#F0F4F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Header bar -->
            <RowDefinition Height="12"/>
            <!-- 1: spacer -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Filter toolbar -->
            <RowDefinition Height="12"/>
            <!-- 3: spacer -->
            <RowDefinition Height="*"/>
            <!-- 4: DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- 5: Footer actions -->
        </Grid.RowDefinitions>

        <!-- ══ ROW 0: HEADER BAR ══ -->
        <Border Grid.Row="0" Background="White" Padding="28,16"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" CornerRadius="2" Background="#2563EB" Margin="0,0,14,0"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Billing" FontSize="12" Foreground="#9CA3AF"/>
                            <TextBlock Text=" / " FontSize="12" Foreground="#D1D5DB"/>
                            <TextBlock Text="History" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#2563EB"/>
                        </StackPanel>
                        <TextBlock Text="Bill History" FontSize="22" FontWeight="Bold"
                                   Foreground="#111827" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="#F0F4F8" CornerRadius="8"
                        Padding="14,8" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtBillCount" Foreground="#6B7280"
                               FontSize="12" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- ══ ROW 2: FILTER TOOLBAR ══ -->
        <Border Grid.Row="2" Background="White" CornerRadius="14"
                Effect="{StaticResource CardShadow}" Margin="28,0,28,0" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Grid Grid.Column="0">
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="13"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="#9CA3AF"/>
                            <TextBox Grid.Column="1"
                                     x:Name="TxtSearch"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#111827"
                                     CaretBrush="#2563EB"
                                     FontSize="13"
                                     Padding="8,10"
                                     VerticalContentAlignment="Center"
                                     TextChanged="TxtSearch_TextChanged"/>
                        </Grid>
                    </Border>
                    <!-- Placeholder -->
                    <TextBlock Text="Search bill no., customer, date…"
                               Foreground="#9CA3AF" FontSize="13"
                               Margin="38,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Date Filter -->
                <ComboBox x:Name="CmbDateFilter" Grid.Column="2"
                          Height="40" FontSize="13"
                          Background="White" Foreground="#111827"
                          BorderBrush="#D1D5DB" BorderThickness="1"
                          VerticalContentAlignment="Center"
                          SelectionChanged="CmbDateFilter_SelectionChanged">
                    <ComboBoxItem Content="All Dates" IsSelected="True"/>
                    <ComboBoxItem Content="Today"/>
                    <ComboBoxItem Content="Last 7 Days"/>
                    <ComboBoxItem Content="This Month"/>
                    <ComboBoxItem Content="Last 3 Months"/>
                </ComboBox>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↻  Refresh"
                            Style="{StaticResource HistoryBtnSecondary}"
                            Width="110" Height="40"
                            Margin="0,0,10,0"
                            Click="BtnRefresh_Click"/>
                    <Button Content="⬇  Export CSV"
                            Style="{StaticResource HistoryBtnSecondary}"
                            Width="130" Height="40"
                            Click="BtnExportCsv_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ ROW 4: BILL DATAGRID ══ -->
        <Border Grid.Row="4" Margin="28,0,28,0" CornerRadius="14"
                Background="White" Effect="{StaticResource CardShadow}"
                ClipToBounds="True">
            <DataGrid x:Name="DgBills"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      Background="White"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F3F4F6"
                      RowHeight="52"
                      AlternatingRowBackground="#FAFAFA"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      ColumnHeaderStyle="{StaticResource HistoryGridHeader}"
                      RowStyle="{StaticResource HistoryGridRow}"
                      CellStyle="{StaticResource HistoryGridCell}"
                      MouseDoubleClick="DgBills_MouseDoubleClick">

                <DataGrid.Columns>

                    <!-- Bill Number -->
                    <DataGridTextColumn Header="BILL NO."
                                        Binding="{Binding BillNumberFormatted}"
                                        Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Date -->
                    <DataGridTextColumn Header="DATE"
                                        Binding="{Binding BillDate, StringFormat={}{0:dd MMM yyyy}}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Time -->
                    <DataGridTextColumn Header="TIME"
                                        Binding="{Binding BillDate, StringFormat={}{0:hh:mm tt}}"
                                        Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Customer Name — shows "Undisclosed Customer" if empty -->
                    <DataGridTemplateColumn Header="CUSTOMER" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding CustomerName}"/>
                                                <Setter Property="Foreground" Value="#374151"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CustomerName}" Value="">
                                                        <Setter Property="Text" Value="Undisclosed Customer"/>
                                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CustomerName}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="Undisclosed Customer"/>
                                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Mobile — shows "-" if empty -->
                    <DataGridTemplateColumn Header="MOBILE" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding CustomerMobile}"/>
                                            <Setter Property="Foreground" Value="#374151"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CustomerMobile}" Value="">
                                                    <Setter Property="Text" Value="-"/>
                                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CustomerMobile}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="-"/>
                                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CustomerMobile}" Value="-">
                                                    <Setter Property="Text" Value="-"/>
                                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Items Count -->
                    <DataGridTextColumn Header="ITEMS"
                                        Binding="{Binding Items.Count}"
                                        Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment"   Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight"      Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Grand Total -->
                    <DataGridTemplateColumn Header="GRAND TOTAL" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GrandTotal, StringFormat=₹{0:N2}}"
                                           FontWeight="Bold" FontSize="13"
                                           Foreground="#16A34A"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Preview inline button -->
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="👁 View"
                                        Width="72" Height="30"
                                        Background="#EFF6FF"
                                        Foreground="#2563EB"
                                        BorderBrush="#BFDBFE"
                                        BorderThickness="1"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        ToolTip="Preview bill"
                                        Tag="{Binding}"
                                        Click="BtnPreviewBill_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══ ROW 5: FOOTER ACTION BAR ══ -->
        <Border Grid.Row="5" Background="White" Padding="28,14"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: hint text -->
                <TextBlock Grid.Column="0"
                           Text="Double-click a row to preview  •  Del key to delete selected"
                           Foreground="#9CA3AF" FontSize="11"
                           VerticalAlignment="Center"/>

                <!-- Right: action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🗑  Delete Selected"
                            Style="{StaticResource DangerBtnSecondary}"
                            Width="150" Height="42"
                            Margin="0,0,10,0"
                            Click="BtnDeleteSelected_Click"/>
                    <Button Content="🖨  Print PDF"
                            Style="{StaticResource HistoryBtnSecondary}"
                            Width="130" Height="42"
                            Margin="0,0,10,0"
                            Click="BtnPrintSelected_Click"/>
                    <Button Content="👁  Preview Selected"
                            Style="{StaticResource SuccessBtn}"
                            Width="160" Height="42"
                            Click="BtnPreviewSelected_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Page>