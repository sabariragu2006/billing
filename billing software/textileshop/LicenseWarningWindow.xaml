<Window x:Class="textileshop.LicenseWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License Expiring Soon"
        Width="580" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Border Background="White" CornerRadius="20" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="6"
                              Color="#000000" Opacity="0.20"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ HERO BANNER — amber ═══ -->
            <Border x:Name="HeroBanner" Grid.Row="0"
                    CornerRadius="20,20,0,0"
                    Background="#B45309">

                <!-- Decorative shapes -->
                <Grid>
                    <Ellipse Width="240" Height="240"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-80,-80,0" Opacity="0.10">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="White"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="160" Height="160"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="-50,0,0,-30" Opacity="0.07">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="White"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="90" Height="90"
                             HorizontalAlignment="Center" VerticalAlignment="Top"
                             Margin="160,-30,0,0" Opacity="0.09">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="White"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Content -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">

                        <!-- Pulsing ring + icon -->
                        <Grid HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Ellipse x:Name="OuterRing"
                                     Width="90" Height="90" Opacity="0.20">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="White"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="72" Height="72" Opacity="0.15"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="White"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Border Width="56" Height="56" CornerRadius="28"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="#FFFFFF" Opacity="0.18"/>
                                </Border.Background>
                                <TextBlock Text="⚠️" FontSize="26"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="License Expiring Soon"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <!-- Countdown pill -->
                        <Border HorizontalAlignment="Center"
                                CornerRadius="20" Padding="18,6">
                            <Border.Background>
                                <SolidColorBrush Color="#000000" Opacity="0.20"/>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏳  "
                                           FontSize="12" Foreground="White"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCountdown"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ BODY ═══ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,26,32,32">

                    <!-- Description -->
                    <TextBlock x:Name="TxtDescription"
                               FontSize="13" Foreground="#6B7280"
                               TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,22"/>

                    <!-- ── Progress bar ── -->
                    <Border Background="#F3F4F6" CornerRadius="12"
                            Padding="18,14" Margin="0,0,0,18"
                            BorderBrush="#E5E7EB" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="License usage"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="#6B7280"/>
                                <TextBlock x:Name="TxtUsagePct"
                                           Grid.Column="1"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="#D97706"/>
                            </Grid>
                            <!-- Track -->
                            <Border Background="#E5E7EB" CornerRadius="4" Height="8">
                                <Border x:Name="ProgressFill"
                                        CornerRadius="4" Height="8"
                                        HorizontalAlignment="Left"
                                        Width="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#F59E0B" Offset="0"/>
                                            <GradientStop Color="#EF4444" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtStartLabel"
                                           FontSize="10" Foreground="#9CA3AF"/>
                                <TextBlock x:Name="TxtEndLabel"
                                           Grid.Column="1"
                                           FontSize="10" Foreground="#9CA3AF"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── Timeline row ── -->
                    <Border Background="#FFFBEB" CornerRadius="12"
                            Padding="18,14" Margin="0,0,0,18"
                            BorderBrush="#FDE68A" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Activated -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <Border Background="#DCFCE7" CornerRadius="8"
                                        Width="34" Height="34"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,6">
                                    <TextBlock Text="✓" FontSize="15" FontWeight="Bold"
                                               Foreground="#16A34A"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="ACTIVATED"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="#9CA3AF"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,3"/>
                                <TextBlock x:Name="TxtActivatedDate"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="#111827"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Arrow -->
                            <TextBlock Grid.Column="1"
                                       Text="→"
                                       FontSize="18" Foreground="#D97706"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="8,0"/>

                            <!-- Expiry -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <Border Background="#FEF3C7" CornerRadius="8"
                                        Width="34" Height="34"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,6">
                                    <TextBlock Text="!" FontSize="15" FontWeight="Bold"
                                               Foreground="#D97706"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="EXPIRES"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="#9CA3AF"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,3"/>
                                <TextBlock x:Name="TxtExpiryDate"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="#D97706"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── DB Path box ── -->
                    <Border Background="#FFFBEB" CornerRadius="12"
                            Padding="16,14" Margin="0,0,0,22"
                            BorderBrush="#FDE68A" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#FEF3C7" CornerRadius="6"
                                        Width="28" Height="28" Margin="0,0,10,0">
                                    <TextBlock Text="📁" FontSize="14"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Your data is safe"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#92400E"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Path row -->
                            <Border Background="White" CornerRadius="8"
                                    BorderBrush="#FDE68A" BorderThickness="1"
                                    Padding="10,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtDbPath"
                                               Grid.Column="0"
                                               FontSize="10" Foreground="#6B7280"
                                               TextWrapping="Wrap"
                                               FontFamily="Consolas"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            x:Name="BtnCopy"
                                            Width="56" Height="28"
                                            Margin="8,0,0,0"
                                            Cursor="Hand"
                                            Click="BtnCopy_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CopyBd" CornerRadius="6"
                                                        Background="#FEF3C7"
                                                        BorderBrush="#FDE68A"
                                                        BorderThickness="1"
                                                        Padding="6,4">
                                                    <TextBlock x:Name="CopyLabel"
                                                               Text="Copy"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="#92400E"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CopyBd" Property="Background" Value="#FDE68A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <TextBlock Text="Keep this file safe. Share it with us when renewing to carry over all your data."
                                       FontSize="11" Foreground="#92400E"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Buttons ── -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Close app -->
                        <Button Grid.Column="0" Height="44" Cursor="Hand"
                                Click="BtnClose_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="10"
                                            BorderBrush="#E5E7EB" BorderThickness="1.5"
                                            Background="White" Padding="12,8">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <TextBlock Text="✕  " FontSize="13"
                                                       FontWeight="Bold" Foreground="#6B7280"/>
                                            <TextBlock Text="Close Application"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#6B7280"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F9FAFB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Continue -->
                        <Button Grid.Column="2" Height="44" Cursor="Hand"
                                Click="BtnContinue_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="10"
                                            Background="#D97706" Padding="12,8">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <TextBlock Text="→  " FontSize="13"
                                                       FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="Continue for Now"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#B45309"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>