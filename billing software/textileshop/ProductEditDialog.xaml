<Window x:Class="textileshop.ProductEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Product"
        Width="720" Height="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- ── Primary button style ── -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#3B82F6"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="20,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary button style ── -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#475569"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#CBD5E1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="20,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ✅ FIXED: Input field style with guaranteed text visibility ── -->
        <Style x:Key="EditInput" TargetType="TextBox">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#1E293B"/>
            <!-- ✅ Dark gray for visibility -->
            <Setter Property="BorderBrush"     Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <!-- ✅ Critical for text centering -->
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MinHeight" Value="44"/>
            <!-- ✅ Ensure minimum height -->
            <Setter Property="CaretBrush" Value="#3B82F6"/>
            <!-- ✅ Remove custom ControlTemplate to avoid rendering issues -->
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Label style ── -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Foreground"      Value="#475569"/>
            <Setter Property="Margin"          Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Form -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ══ Header ══ -->
        <Border Grid.Row="0" Padding="24,18,24,16"
                Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#3B82F6" CornerRadius="4"
                                Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="EDIT" FontSize="9" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Product Details"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#1E293B"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtProductId"
                               FontSize="11" Foreground="#64748B"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="✕"
                        Width="32" Height="32"
                        Background="Transparent"
                        Foreground="#64748B"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Close"
                        Click="BtnCancel_Click"/>
            </Grid>
        </Border>

        <!-- ══ Form Content ══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel>

                <!-- Product Name -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Product Name *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtProductName"
                             Style="{StaticResource EditInput}"
                             Height="44"
                             VerticalContentAlignment="Center"/>
                    <!-- ✅ Explicit centering -->
                </StackPanel>

                <!-- Row: Qty + Rate -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Quantity *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtQty"
                                 Style="{StaticResource EditInput}"
                                 Height="44"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Rate (₹) *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtRate"
                                 Style="{StaticResource EditInput}"
                                 Height="44"/>
                    </StackPanel>
                </Grid>

                <!-- CD -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="CD" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtCD"
                             Style="{StaticResource EditInput}"
                             Height="44"/>
                </StackPanel>

                <!-- Cost Total -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Cost Total (₹) *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtCostTotal"
                             Style="{StaticResource EditInput}"
                             Height="44"/>
                </StackPanel>

                <!-- Divider -->
                <Rectangle Height="1" Fill="#E2E8F0" Margin="0,8,0,20"/>
                <TextBlock Text="Tax Details"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#1E293B"
                           Margin="0,0,0,16"/>

                <!-- CGST -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CGST %" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtCGSTPct"
                                 Style="{StaticResource EditInput}"
                                 Height="44"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="CGST Amt (₹) *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtCGSTAmt"
                                 Style="{StaticResource EditInput}"
                                 Height="44"/>
                    </StackPanel>
                </Grid>

                <!-- SGST -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SGST %" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtSGSTPct"
                                 Style="{StaticResource EditInput}"
                                 Height="44"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SGST Amt (₹) *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtSGSTAmt"
                                 Style="{StaticResource EditInput}"
                                 Height="44"/>
                    </StackPanel>
                </Grid>

                <!-- Net Rate -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Net Rate (₹) *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtNetRate"
                             Style="{StaticResource EditInput}"
                             Height="44"/>
                </StackPanel>

                <!-- Validation Message -->
                <TextBlock x:Name="TxtValidation"
                           Foreground="#DC2626"
                           FontSize="12"
                           Margin="0,8,0,0"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </ScrollViewer>

        <!-- ══ Footer ══ -->
        <Border Grid.Row="2" Padding="24,16"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Width="120" Height="44"
                        Style="{StaticResource SecondaryBtn}"
                        Margin="0,0,12,0"
                        Click="BtnCancel_Click"/>
                <Button Content="💾  Save Changes"
                        Width="160" Height="44"
                        Style="{StaticResource PrimaryBtn}"
                        Click="BtnSaveChanges_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>