<!-- SalesReportPage.xaml — White/Violet Theme -->
<Page x:Class="textileshop.SalesReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="1400"
      Background="#F0F4FF"
      FontFamily="Segoe UI"
      Title="Sales Report">

    <Page.Resources>

        <!-- Toggle Button Style -->
        <Style x:Key="ViewToggleButton" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#4F46E5"/>
            <Setter Property="BorderBrush"     Value="#C7D2FE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Toggle Button Style -->
        <Style x:Key="ViewToggleButtonActive" TargetType="Button" BasedOn="{StaticResource ViewToggleButton}">
            <Setter Property="Background"  Value="#4F46E5"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#4F46E5"/>
        </Style>

        <!-- KPI Card Style -->
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#EEF2FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="14"/>
            <Setter Property="Padding"         Value="20,18"/>
            <Setter Property="Margin"          Value="0,0,12,0"/>
        </Style>

        <!-- DataGrid Header Style -->
        <Style x:Key="ReportGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#F5F3FF"/>
            <Setter Property="Foreground"      Value="#6B7280"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="#EEF2FF"/>
        </Style>

    </Page.Resources>

    <StackPanel>

        <!-- ══ TOP ACCENT BAR ══ -->
        <Border Height="6">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#4F46E5" Offset="0"/>
                    <GradientStop Color="#7C3AED" Offset="0.5"/>
                    <GradientStop Color="#A855F7" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header      -->
                <RowDefinition Height="16"/>
                <!-- spacer      -->
                <RowDefinition Height="Auto"/>
                <!-- KPI Cards   -->
                <RowDefinition Height="16"/>
                <!-- spacer      -->
                <RowDefinition Height="Auto"/>
                <!-- Toggle/Filter -->
                <RowDefinition Height="16"/>
                <!-- spacer      -->
                <RowDefinition Height="*"/>
                <!-- Content     -->
            </Grid.RowDefinitions>

            <!-- ══ HEADER ══ -->
            <Border Grid.Row="0" Padding="24,20" Background="White"
                    CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect Color="#C7D2FE" Opacity="0.45" BlurRadius="16" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="3" Height="16" CornerRadius="2"
                                    Margin="0,0,10,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#4F46E5" Offset="0"/>
                                        <GradientStop Color="#7C3AED" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border Background="#EEF2FF" CornerRadius="20" Padding="10,4">
                                <TextBlock Text="REPORTS" FontSize="9" FontWeight="Bold"
                                           Foreground="#4F46E5"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Sales Report" FontSize="22" FontWeight="Bold"
                                   Foreground="#1E1B4B"/>
                        <TextBlock x:Name="TxtDateRange" FontSize="11" Foreground="#6B7280"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Date range buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📅 Last 7 Days"  Style="{StaticResource ViewToggleButton}"
                                Width="120" Height="38" Margin="0,0,8,0"
                                Click="BtnDateRange_Click" Tag="7"/>
                        <Button Content="📅 Last 30 Days" Style="{StaticResource ViewToggleButton}"
                                Width="130" Height="38" Margin="0,0,8,0"
                                Click="BtnDateRange_Click" Tag="30"/>
                        <Button Content="📅 This Month"   Style="{StaticResource ViewToggleButton}"
                                Width="120" Height="38"
                                Click="BtnDateRange_Click" Tag="month"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ KPI CARDS ══ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Sales -->
                <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                    <Border.Effect>
                        <DropShadowEffect Color="#C7D2FE" Opacity="0.4" BlurRadius="14" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" CornerRadius="2,2,0,0" Margin="-20,-18,-12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#4F46E5" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <Border Background="#EEF2FF" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                                <TextBlock Text="💰" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Total Sales" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#6B7280" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" x:Name="KpiTotalSales" Text="₹ 0.00"
                                   FontSize="24" FontWeight="Bold" Foreground="#1E1B4B" Margin="0,6,0,4"/>
                        <Border Grid.Row="3" Background="#EEF2FF" CornerRadius="20"
                                Padding="8,3" HorizontalAlignment="Left">
                            <TextBlock Text="Total revenue" FontSize="10" FontWeight="SemiBold" Foreground="#4F46E5"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Total Bills -->
                <Border Grid.Column="1" Style="{StaticResource KpiCard}">
                    <Border.Effect>
                        <DropShadowEffect Color="#C7D2FE" Opacity="0.4" BlurRadius="14" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" CornerRadius="2,2,0,0" Margin="-20,-18,-12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                    <GradientStop Color="#A855F7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <Border Background="#F5F3FF" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                                <TextBlock Text="🧾" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Total Bills" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#6B7280" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" x:Name="KpiTotalBills" Text="0"
                                   FontSize="24" FontWeight="Bold" Foreground="#1E1B4B" Margin="0,6,0,4"/>
                        <Border Grid.Row="3" Background="#F5F3FF" CornerRadius="20"
                                Padding="8,3" HorizontalAlignment="Left">
                            <TextBlock Text="Number of invoices" FontSize="10" FontWeight="SemiBold" Foreground="#7C3AED"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Items Sold -->
                <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                    <Border.Effect>
                        <DropShadowEffect Color="#C7D2FE" Opacity="0.4" BlurRadius="14" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" CornerRadius="2,2,0,0" Margin="-20,-18,-12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#4338CA" Offset="0"/>
                                    <GradientStop Color="#6D28D9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <Border Background="#EEF2FF" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                                <TextBlock Text="📦" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Items Sold" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#6B7280" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" x:Name="KpiItemsSold" Text="0"
                                   FontSize="24" FontWeight="Bold" Foreground="#1E1B4B" Margin="0,6,0,4"/>
                        <Border Grid.Row="3" Background="#EEF2FF" CornerRadius="20"
                                Padding="8,3" HorizontalAlignment="Left">
                            <TextBlock Text="Total quantity" FontSize="10" FontWeight="SemiBold" Foreground="#4338CA"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Customers -->
                <Border Grid.Column="3" Style="{StaticResource KpiCard}" Margin="0">
                    <Border.Effect>
                        <DropShadowEffect Color="#C7D2FE" Opacity="0.4" BlurRadius="14" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" CornerRadius="2,2,0,0" Margin="-20,-18,-20,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#6D28D9" Offset="0"/>
                                    <GradientStop Color="#A855F7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <Border Background="#F5F3FF" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                                <TextBlock Text="👥" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Customers" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#6B7280" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" x:Name="KpiCustomers" Text="0"
                                   FontSize="24" FontWeight="Bold" Foreground="#1E1B4B" Margin="0,6,0,4"/>
                        <Border Grid.Row="3" Background="#F5F3FF" CornerRadius="20"
                                Padding="8,3" HorizontalAlignment="Left">
                            <TextBlock Text="Unique customers" FontSize="10" FontWeight="SemiBold" Foreground="#6D28D9"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ VIEW TOGGLE & FILTERS ══ -->
            <Border Grid.Row="4" Background="White" CornerRadius="14" Padding="20,14">
                <Border.Effect>
                    <DropShadowEffect Color="#C7D2FE" Opacity="0.4" BlurRadius="14" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="BtnGraphView" Content="📊 Graphical View"
                                Style="{StaticResource ViewToggleButtonActive}"
                                Width="160" Height="38" Margin="0,0,8,0"
                                Click="BtnViewToggle_Click" Tag="graph"/>
                        <Button x:Name="BtnTableView" Content="📋 Table View"
                                Style="{StaticResource ViewToggleButton}"
                                Width="140" Height="38"
                                Click="BtnViewToggle_Click" Tag="table"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="📤 Export CSV"
                                Style="{StaticResource ViewToggleButton}"
                                Width="120" Height="38" Margin="0,0,8,0"
                                Click="BtnExport_Click"/>
                        <Button Content="🖨 Print"
                                Style="{StaticResource ViewToggleButton}"
                                Width="100" Height="38"
                                Click="BtnPrint_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ CONTENT AREA ══ -->
            <Grid Grid.Row="6">

                <!-- Graphical View -->
                <Border x:Name="PanelGraphView" Background="White" CornerRadius="14" Padding="24">
                    <Border.Effect>
                        <DropShadowEffect Color="#C7D2FE" Opacity="0.4" BlurRadius="14" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Background="#EEF2FF" CornerRadius="6" Width="4" Margin="0,0,10,0"/>
                            <TextBlock Text="📈 Sales Trend (Daily)"
                                       FontSize="16" FontWeight="Bold" Foreground="#1E1B4B"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <Canvas x:Name="ChartCanvas" Margin="40,20,20,40" ClipToBounds="False"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Table View -->
                <Border x:Name="PanelTableView" Background="White" CornerRadius="14"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="#C7D2FE" Opacity="0.4" BlurRadius="14" ShadowDepth="2"/>
                    </Border.Effect>
                    <DataGrid x:Name="DgSalesReport" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" Background="White" BorderThickness="0"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF2FF"
                              RowHeight="44" AlternatingRowBackground="#FAFBFF"
                              SelectionMode="Single" HeadersVisibility="Column"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              ColumnHeaderStyle="{StaticResource ReportGridHeader}">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5F3FF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EEF2FF"/>
                                        <Setter Property="Foreground" Value="#1E1B4B"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="Foreground" Value="#374151"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#1E1B4B"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding Date, StringFormat={}{0:dd MMM yyyy}}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Bill No."
                                                Binding="{Binding BillNumber}"
                                                Width="150"/>
                            <DataGridTextColumn Header="Customer"
                                                Binding="{Binding CustomerName}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Items"
                                                Binding="{Binding ItemsCount}"
                                                Width="80"/>
                            <DataGridTextColumn Header="Subtotal"
                                                Binding="{Binding SubTotal, StringFormat={}{0:N2}}"
                                                Width="100"/>
                            <DataGridTextColumn Header="CGST"
                                                Binding="{Binding CGST, StringFormat={}{0:N2}}"
                                                Width="90"/>
                            <DataGridTextColumn Header="SGST"
                                                Binding="{Binding SGST, StringFormat={}{0:N2}}"
                                                Width="90"/>
                            <DataGridTextColumn Header="Total"
                                                Binding="{Binding Total, StringFormat={}{0:N2}}"
                                                Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#4F46E5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

        </Grid>
    </StackPanel>
</Page>