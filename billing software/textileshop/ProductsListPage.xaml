<Page x:Class="textileshop.ProductsListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="1440"
      Background="#F0F4FF"
      FontFamily="Segoe UI">

    <Page.Resources>

        <DropShadowEffect x:Key="CardShadow"   BlurRadius="16" ShadowDepth="2"
                          Direction="270" Color="#C7D2FE" Opacity="0.4"/>
        <DropShadowEffect x:Key="HeaderShadow" BlurRadius="14" ShadowDepth="1"
                          Direction="270" Color="#C7D2FE" Opacity="0.35"/>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#4F46E5"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3730A3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#C7D2FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#4F46E5"/>
            <Setter Property="BorderBrush"     Value="#C7D2FE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background"      Value="#FEF2F2"/>
            <Setter Property="Foreground"      Value="#DC2626"/>
            <Setter Property="BorderBrush"     Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditBtn" TargetType="Button">
            <Setter Property="Background"      Value="#EEF2FF"/>
            <Setter Property="Foreground"      Value="#4F46E5"/>
            <Setter Property="BorderBrush"     Value="#C7D2FE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipBtn" TargetType="ToggleButton">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#6B7280"/>
            <Setter Property="BorderBrush"     Value="#C7D2FE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#4F46E5"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Edit Modal Field Label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin"     Value="0,0,0,5"/>
        </Style>

        <Style x:Key="LightCombo" TargetType="ComboBox">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#1E1B4B"/>
            <Setter Property="BorderBrush"     Value="#C7D2FE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="Height"          Value="40"/>
        </Style>

        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#F5F3FF"/>
            <Setter Property="Foreground"      Value="#6B7280"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="#EEF2FF"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridRow" TargetType="DataGridRow">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="#374151"/>
            <Setter Property="FontSize"        Value="13"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StockStatus}" Value="Out">
                    <Setter Property="Foreground" Value="#DC2626"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StockStatus}" Value="Low">
                    <Setter Property="Foreground" Value="#B45309"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F3FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEF2FF"/>
                    <Setter Property="Foreground" Value="#1E1B4B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="14,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#1E1B4B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <Grid Background="#F0F4FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ACCENT BAR -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#4F46E5" Offset="0"/>
                    <GradientStop Color="#7C3AED" Offset="0.5"/>
                    <GradientStop Color="#A855F7" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- HEADER BAR -->
        <Border Grid.Row="1" Background="White" Padding="28,18"
                Effect="{StaticResource HeaderShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" CornerRadius="2" Margin="0,0,16,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#4F46E5" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Inventory" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <TextBlock Text=" / " FontSize="12" Foreground="#C7D2FE" VerticalAlignment="Center"/>
                                <TextBlock Text="Products" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#4F46E5" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Product Inventory" FontSize="22" FontWeight="Bold"
                                       Foreground="#1E1B4B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="TxtLastRefresh" FontSize="11" Foreground="#9CA3AF" Margin="20,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRefresh" Content="↻  Refresh"
                            Style="{StaticResource SecondaryBtn}"
                            Width="112" Height="40" Margin="0,0,10,0"
                            Click="BtnRefresh_Click"/>
                    <Button x:Name="BtnExportCsv" Content="⬇  Export CSV"
                            Style="{StaticResource SecondaryBtn}"
                            Width="130" Height="40" Margin="0,0,10,0"
                            Click="BtnExportCsv_Click"/>
                    <Button Content="+ Add Product"
                            Style="{StaticResource PrimaryBtn}"
                            Height="40" Click="BtnAddProduct_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPI CARDS -->
        <Grid Grid.Row="3" Margin="28,0,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="14"
                    Effect="{StaticResource CardShadow}" Padding="22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="2,2,0,0" Margin="-22,-18,-22,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#4F46E5" Offset="0"/>
                                <GradientStop Color="#7C3AED" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Background="#EEF2FF" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                            <TextBlock Text="📦" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Total Products" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#6B7280" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="KpiTotal" Text="0"
                               FontSize="36" FontWeight="Bold" Foreground="#1E1B4B" Margin="0,8,0,6"/>
                    <Border Grid.Row="3" Background="#EEF2FF" CornerRadius="20" Padding="10,3" HorizontalAlignment="Left">
                        <TextBlock Text="All categories" FontSize="11" FontWeight="SemiBold" Foreground="#4F46E5"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="14"
                    Effect="{StaticResource CardShadow}" Padding="22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="2,2,0,0" Margin="-22,-18,-22,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F59E0B" Offset="0"/>
                                <GradientStop Color="#FBBF24" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Background="#FFFBEB" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                            <TextBlock Text="⚠️" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Low Stock" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#6B7280" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="KpiLowStock" Text="0"
                               FontSize="36" FontWeight="Bold" Foreground="#D97706" Margin="0,8,0,6"/>
                    <Border Grid.Row="3" Background="#FEF3C7" CornerRadius="20" Padding="10,3" HorizontalAlignment="Left">
                        <TextBlock Text="Near threshold" FontSize="11" FontWeight="SemiBold" Foreground="#92400E"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="White" CornerRadius="14"
                    Effect="{StaticResource CardShadow}" Padding="22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="2,2,0,0" Margin="-22,-18,-22,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#EF4444" Offset="0"/>
                                <GradientStop Color="#F87171" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Background="#FEF2F2" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                            <TextBlock Text="🚫" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Out of Stock" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#6B7280" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="KpiOutStock" Text="0"
                               FontSize="36" FontWeight="Bold" Foreground="#DC2626" Margin="0,8,0,6"/>
                    <Border Grid.Row="3" Background="#FEE2E2" CornerRadius="20" Padding="10,3" HorizontalAlignment="Left">
                        <TextBlock Text="Needs restocking" FontSize="11" FontWeight="SemiBold" Foreground="#991B1B"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="6" Background="White" CornerRadius="14"
                    Effect="{StaticResource CardShadow}" Padding="22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="2,2,0,0" Margin="-22,-18,-22,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#10B981" Offset="0"/>
                                <GradientStop Color="#34D399" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Background="#F0FDF4" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                            <TextBlock Text="💰" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Total Value" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#6B7280" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="KpiValue" Text="₹ 0.00"
                               FontSize="30" FontWeight="Bold" Foreground="#16A34A" Margin="0,8,0,6"/>
                    <Border Grid.Row="3" Background="#DCFCE7" CornerRadius="20" Padding="10,3" HorizontalAlignment="Left">
                        <TextBlock Text="Inventory worth" FontSize="11" FontWeight="SemiBold" Foreground="#166534"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- FILTER TOOLBAR -->
        <Border Grid.Row="5" Background="White" CornerRadius="14"
                Effect="{StaticResource CardShadow}" Margin="28,0,28,0" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="260" Margin="0,0,16,0">
                        <Border Background="#F5F3FF" BorderBrush="#C7D2FE"
                                BorderThickness="1.5" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="13"
                                           VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#818CF8"/>
                                <TextBox Grid.Column="1" x:Name="TxtSearch"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="#1E1B4B" CaretBrush="#4F46E5"
                                         FontSize="13" Padding="8,10"
                                         VerticalContentAlignment="Center"
                                         TextChanged="TxtSearch_TextChanged"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="Search products..." Foreground="#A5B4FC"
                                   FontSize="13" Margin="38,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Rectangle Width="1" Height="26" Fill="#C7D2FE" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="ChipAll"     Content="All"
                                  Style="{StaticResource ChipBtn}" IsChecked="True"
                                  Margin="0,0,8,0" Checked="StockChip_Checked"/>
                    <ToggleButton x:Name="ChipInStock" Content="✓ In Stock"
                                  Style="{StaticResource ChipBtn}"
                                  Margin="0,0,8,0" Checked="StockChip_Checked"/>
                    <ToggleButton x:Name="ChipLow"     Content="⚠ Low Stock"
                                  Style="{StaticResource ChipBtn}"
                                  Margin="0,0,8,0" Checked="StockChip_Checked"/>
                    <ToggleButton x:Name="ChipOrder"   Content="🚫 Needs Order"
                                  Style="{StaticResource ChipBtn}"
                                  Margin="0,0,16,0" Checked="StockChip_Checked"/>
                    <Rectangle Width="1" Height="26" Fill="#C7D2FE" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Threshold" Foreground="#6B7280" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtThreshold" Width="68" Height="38" Text="10"
                             FontSize="13" Padding="8,6" VerticalContentAlignment="Center"
                             Background="White" Foreground="#1E1B4B" CaretBrush="#4F46E5"
                             BorderBrush="#C7D2FE" BorderThickness="1.5"
                             TextChanged="TxtThreshold_TextChanged"/>
                    <TextBlock Text="units" Foreground="#6B7280" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SORT BY" Foreground="#9CA3AF" FontSize="10"
                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="CmbSort" Style="{StaticResource LightCombo}"
                              Width="190" SelectionChanged="CmbSort_SelectionChanged">
                        <ComboBoxItem Content="Name A → Z" IsSelected="True"/>
                        <ComboBoxItem Content="Name Z → A"/>
                        <ComboBoxItem Content="Qty: Low → High"/>
                        <ComboBoxItem Content="Qty: High → Low"/>
                        <ComboBoxItem Content="Net Rate: Low → High"/>
                        <ComboBoxItem Content="Net Rate: High → Low"/>
                        <ComboBoxItem Content="Imported: Newest"/>
                        <ComboBoxItem Content="Imported: Oldest"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DATAGRID -->
        <Border Grid.Row="7" Margin="28,0,28,0" CornerRadius="14"
                Background="White" Effect="{StaticResource CardShadow}" ClipToBounds="True">
            <DataGrid x:Name="DgProducts"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" Background="White" BorderThickness="0"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF2FF"
                      RowHeight="52" AlternatingRowBackground="#FAFBFF"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      ColumnHeaderStyle="{StaticResource GridHeader}"
                      RowStyle="{StaticResource GridRow}"
                      CellStyle="{StaticResource GridCell}">
                <DataGrid.Columns>

                    <DataGridTextColumn Header="PRODUCT ID"
                                        Binding="{Binding Id}" Width="110"/>

                    <DataGridTextColumn Header="PRODUCT NAME"
                                        Binding="{Binding ProductName}" Width="2.2*"/>

                    <DataGridTemplateColumn Header="STOCK" Width="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="StockBadge" CornerRadius="20" Padding="12,4"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Tag="{Binding StockStatus}" Loaded="StockBadge_Loaded">
                                    <TextBlock x:Name="StockBadgeTxt" Text="{Binding Qty}"
                                               FontSize="12" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="SALES RATE"
                                        Binding="{Binding Rate, StringFormat=₹{0:N2}}" Width="*"/>

                    <DataGridTextColumn Header="PURCHASE PRICE"
                                        Binding="{Binding PurchasePrice, StringFormat=₹{0:N2}}" Width="*"/>

                    <DataGridTemplateColumn Header="PROFIT AMT" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ProfitAmount, StringFormat=₹{0:N2}}"
                                           FontWeight="SemiBold" Foreground="#16A34A"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="PROFIT %" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ProfitPct, StringFormat={}{0:N1}%}"
                                           FontWeight="SemiBold" Foreground="#16A34A"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="CGST %"
                                        Binding="{Binding CGSTPct, StringFormat={}{0:N1}}" Width="75"/>

                    <DataGridTextColumn Header="SGST %"
                                        Binding="{Binding SGSTPct, StringFormat={}{0:N1}}" Width="75"/>

                    <DataGridTemplateColumn Header="NET RATE" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NetRate, StringFormat=₹{0:N2}}"
                                           FontWeight="SemiBold" Foreground="#4F46E5"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="IMPORTED"
                                        Binding="{Binding ImportedAt}" Width="1.2*"/>

                    <DataGridTemplateColumn Header="ACTIONS" Width="140" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                    <Button Content="✎" Style="{StaticResource EditBtn}"
                                            Height="30" Margin="0,0,6,0" Width="58"
                                            ToolTip="Edit product" Tag="{Binding}"
                                            Click="BtnEdit_Click"/>
                                    <Button Content="🗑" Style="{StaticResource DangerBtn}"
                                            Height="30" Width="52"
                                            ToolTip="Delete product" Tag="{Binding}"
                                            Click="BtnDelete_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="8" Background="White" Padding="28,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EEF2FF" CornerRadius="6" Padding="10,4" Margin="0,0,12,0">
                        <TextBlock x:Name="TxtStatus" Foreground="#4F46E5"
                                   FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TxtShowing"
                           Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══ EDIT MODAL OVERLAY ══ -->
        <Grid x:Name="EditModalOverlay"
      Grid.Row="0" Grid.RowSpan="9"
      Background="#801E1B4B"
      Visibility="Collapsed"
      Panel.ZIndex="200"
      Focusable="True"
      KeyDown="EditModal_KeyDown">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="60">
                <Border Background="White" CornerRadius="16"
                        Padding="36,32" HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="820" MinWidth="560"
                        BorderBrush="#EEF2FF" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#1E1B4B" Opacity="0.22"
                                          BlurRadius="32" ShadowDepth="0"/>
                    </Border.Effect>

                    <StackPanel KeyboardNavigation.TabNavigation="Cycle">

                        <!-- Modal Header -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Edit Product" FontSize="20" FontWeight="Bold"
                                           Foreground="#1E1B4B"/>
                                <TextBlock Text="Tab between fields · Enter on last field to save · Esc to cancel"
                                           FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="✅ Save"
                                        Style="{StaticResource PrimaryBtn}"
                                        Width="110" Height="40" Margin="0,0,10,0"
                                        Click="BtnEditSave_Click"/>
                                <Button Content="✕ Cancel"
                                        Style="{StaticResource SecondaryBtn}"
                                        Width="100" Height="40"
                                        Click="BtnEditCancel_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#EEF2FF" Margin="0,0,0,22"/>

                        <!-- Product Name -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="PRODUCT NAME *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EditTxtProductName"
                                     Height="44" FontSize="13" Padding="12,10"
                                     Background="White" Foreground="#1E1B4B"
                                     CaretBrush="#4F46E5" BorderBrush="#C7D2FE"
                                     BorderThickness="1.5" VerticalContentAlignment="Center"
                                     TabIndex="1"/>
                        </StackPanel>

                        <!-- Row: Qty | Sales Rate -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="QUANTITY *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="EditTxtQty"
                                         Height="44" FontSize="13" Padding="12,10"
                                         Background="White" Foreground="#1E1B4B"
                                         CaretBrush="#4F46E5" BorderBrush="#C7D2FE"
                                         BorderThickness="1.5" VerticalContentAlignment="Center"
                                         TabIndex="2"
                                         TextChanged="EditTxt_Calculate_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SALES RATE (₹) *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="EditTxtRate"
                                         Height="44" FontSize="13" Padding="12,10"
                                         Background="White" Foreground="#1E1B4B"
                                         CaretBrush="#4F46E5" BorderBrush="#C7D2FE"
                                         BorderThickness="1.5" VerticalContentAlignment="Center"
                                         TabIndex="3"
                                         TextChanged="EditTxt_Calculate_Changed"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row: Purchase Price | Net Rate (auto) -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PURCHASE PRICE (₹) *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="EditTxtPurchasePrice"
                                         Height="44" FontSize="13" Padding="12,10"
                                         Background="White" Foreground="#1E1B4B"
                                         CaretBrush="#4F46E5" BorderBrush="#C7D2FE"
                                         BorderThickness="1.5" VerticalContentAlignment="Center"
                                         TabIndex="4"
                                         TextChanged="EditTxt_Calculate_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="NET RATE (₹)  —  auto" Style="{StaticResource FieldLabel}"
                                           Foreground="#4F46E5"/>
                                <TextBox x:Name="EditTxtNetRate"
                                         Height="44" FontSize="13" Padding="12,10"
                                         Background="#EEF2FF" Foreground="#4F46E5"
                                         BorderBrush="#C7D2FE" BorderThickness="1.5"
                                         FontWeight="Bold" IsReadOnly="True"
                                         VerticalContentAlignment="Center" Text="0.00"
                                         TabIndex="99"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row: CGST | SGST -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CGST %" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="EditTxtCGST"
                                         Height="44" FontSize="13" Padding="12,10"
                                         Background="White" Foreground="#1E1B4B"
                                         CaretBrush="#4F46E5" BorderBrush="#C7D2FE"
                                         BorderThickness="1.5" VerticalContentAlignment="Center"
                                         TabIndex="5"
                                         TextChanged="EditTxt_Calculate_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SGST %" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="EditTxtSGST"
                                         Height="44" FontSize="13" Padding="12,10"
                                         Background="White" Foreground="#1E1B4B"
                                         CaretBrush="#4F46E5" BorderBrush="#C7D2FE"
                                         BorderThickness="1.5" VerticalContentAlignment="Center"
                                         TabIndex="6"
                                         TextChanged="EditTxt_Calculate_Changed"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row: Profit Amount | Profit % (auto) -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PROFIT AMOUNT (₹)  —  auto"
                                           Style="{StaticResource FieldLabel}" Foreground="#16A34A"/>
                                <TextBox x:Name="EditTxtProfitAmount"
                                         Height="44" FontSize="13" Padding="12,10"
                                         Background="#F0FDF4" Foreground="#16A34A"
                                         BorderBrush="#C7D2FE" BorderThickness="1.5"
                                         FontWeight="Bold" IsReadOnly="True"
                                         VerticalContentAlignment="Center" Text="0.00"
                                         TabIndex="99"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PROFIT %  —  auto"
                                           Style="{StaticResource FieldLabel}" Foreground="#16A34A"/>
                                <TextBox x:Name="EditTxtProfitPct"
                                         Height="44" FontSize="13" Padding="12,10"
                                         Background="#F0FDF4" Foreground="#16A34A"
                                         BorderBrush="#C7D2FE" BorderThickness="1.5"
                                         FontWeight="Bold" IsReadOnly="True"
                                         VerticalContentAlignment="Center" Text="0.00 %"
                                         TabIndex="99"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

    </Grid>
</Page>