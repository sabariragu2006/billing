<Page x:Class="room_booking.SalesReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Sales Report"
      Background="#F1F8E9"
      FontFamily="Segoe UI">

    <Page.Resources>

        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="BorderBrush" Value="#A5D6A7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="TableHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1B5E20"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <Style x:Key="TableCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1B5E20"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FilterBtn" TargetType="RadioButton">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E7D32"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C8E6C9"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="#1B5E20"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">

            <!-- ── Page Header ── -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📈" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Sales " FontSize="24" FontWeight="Bold"
                                   Foreground="#1B5E20" VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text="Report" FontSize="24" FontWeight="Bold"
                                   Foreground="#2E7D32" VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtSubtitle" FontSize="13" FontFamily="Segoe UI"
                               Foreground="#81C784" Margin="0,4,0,0"
                               Text="Revenue and occupancy analytics"/>
                </StackPanel>

                <!-- Date Range + Export -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="From" VerticalAlignment="Center" Foreground="#2E7D32"
                               FontSize="13" FontFamily="Segoe UI" FontWeight="Bold"
                               Margin="0,0,8,0"/>
                    <DatePicker x:Name="DpFrom" Width="140" FontSize="13"/>
                    <TextBlock Text="To" VerticalAlignment="Center" Foreground="#2E7D32"
                               FontSize="13" FontFamily="Segoe UI" FontWeight="Bold"
                               Margin="12,0,8,0"/>
                    <DatePicker x:Name="DpTo" Width="140" FontSize="13"/>

                    <Button Content="Export CSV" Click="ExportCsv_Click"
                            Margin="14,0,0,0" Padding="16,8"
                            Background="#C8E6C9" BorderBrush="#A5D6A7" BorderThickness="1.5"
                            Foreground="#1B5E20" FontSize="13" FontWeight="Bold"
                            FontFamily="Segoe UI" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── Period Filter Tabs ── -->
            <Border Background="White" CornerRadius="10" Padding="4"
                    Margin="0,0,0,20" HorizontalAlignment="Left"
                    BorderBrush="#A5D6A7" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#000000"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbToday"   Content="Today"        GroupName="Period" Style="{StaticResource FilterBtn}" IsChecked="False" Margin="0,0,4,0"/>
                    <RadioButton x:Name="RbWeek"    Content="This Week"    GroupName="Period" Style="{StaticResource FilterBtn}" IsChecked="False" Margin="0,0,4,0"/>
                    <RadioButton x:Name="RbMonth"   Content="This Month"   GroupName="Period" Style="{StaticResource FilterBtn}" IsChecked="True"  Margin="0,0,4,0"/>
                    <RadioButton x:Name="RbQuarter" Content="This Quarter" GroupName="Period" Style="{StaticResource FilterBtn}" IsChecked="False" Margin="0,0,4,0"/>
                    <RadioButton x:Name="RbYear"    Content="This Year"    GroupName="Period" Style="{StaticResource FilterBtn}" IsChecked="False" Margin="0,0,4,0"/>
                    <RadioButton x:Name="RbCustom"  Content="Custom"       GroupName="Period" Style="{StaticResource FilterBtn}" IsChecked="False"/>
                </StackPanel>
            </Border>

            <!-- ── KPI Cards ── -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Revenue -->
                <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <Border Background="#C8E6C9" CornerRadius="8" Padding="8"
                                Width="40" Height="40" HorizontalAlignment="Left"
                                Margin="0,0,0,12">
                            <TextBlock Text="₹" FontSize="18" Foreground="#1B5E20"
                                       FontWeight="Bold" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="TOTAL REVENUE" FontSize="11" FontWeight="Bold"
                                   FontFamily="Segoe UI" Foreground="#2E7D32"/>
                        <TextBlock x:Name="TxtTotalRevenue" Text="₹0" FontSize="28"
                                   FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="#1B5E20" Margin="0,4,0,2"/>
                        <TextBlock x:Name="TxtRevenueDelta" FontSize="12"
                                   FontFamily="Segoe UI" Foreground="#2E7D32"/>
                    </StackPanel>
                </Border>

                <!-- Total Bookings -->
                <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <Border Background="#A5D6A7" CornerRadius="8" Padding="8"
                                Width="40" Height="40" HorizontalAlignment="Left"
                                Margin="0,0,0,12">
                            <TextBlock Text="🛎" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="TOTAL CHECKOUTS" FontSize="11" FontWeight="Bold"
                                   FontFamily="Segoe UI" Foreground="#2E7D32"/>
                        <TextBlock x:Name="TxtTotalBookings" Text="0" FontSize="28"
                                   FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="#1B5E20" Margin="0,4,0,2"/>
                        <TextBlock x:Name="TxtBookingsDelta" FontSize="12"
                                   FontFamily="Segoe UI" Foreground="#2E7D32"/>
                    </StackPanel>
                </Border>

                <!-- Avg Stay Duration -->
                <Border Grid.Column="4" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <Border Background="#C8E6C9" CornerRadius="8" Padding="8"
                                Width="40" Height="40" HorizontalAlignment="Left"
                                Margin="0,0,0,12">
                            <TextBlock Text="📅" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="AVG STAY (DAYS)" FontSize="11" FontWeight="Bold"
                                   FontFamily="Segoe UI" Foreground="#2E7D32"/>
                        <TextBlock x:Name="TxtAvgStay" Text="0" FontSize="28"
                                   FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="#1B5E20" Margin="0,4,0,2"/>
                        <TextBlock x:Name="TxtAvgStayDelta" FontSize="12"
                                   FontFamily="Segoe UI" Foreground="#2E7D32"/>
                    </StackPanel>
                </Border>

                <!-- Occupancy Rate -->
                <Border Grid.Column="6" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <Border Background="#A5D6A7" CornerRadius="8" Padding="8"
                                Width="40" Height="40" HorizontalAlignment="Left"
                                Margin="0,0,0,12">
                            <TextBlock Text="🏨" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="OCCUPANCY RATE" FontSize="11" FontWeight="Bold"
                                   FontFamily="Segoe UI" Foreground="#2E7D32"/>
                        <TextBlock x:Name="TxtOccupancy" Text="0%" FontSize="28"
                                   FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="#1B5E20" Margin="0,4,0,2"/>
                        <TextBlock x:Name="TxtOccupancyDelta" FontSize="12"
                                   FontFamily="Segoe UI" Foreground="#2E7D32"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Revenue Trend Chart + Room Type Breakdown ── -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Revenue Bar Chart -->
                <Border Grid.Column="0" Background="White" CornerRadius="14"
                        Padding="22" BorderBrush="#A5D6A7" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Revenue Trend" FontSize="15" FontWeight="Bold"
                                       FontFamily="Segoe UI" Foreground="#1B5E20"/>
                            <TextBlock x:Name="TxtChartPeriodLabel" Grid.Column="1"
                                       FontSize="12" FontFamily="Segoe UI"
                                       Foreground="#81C784" VerticalAlignment="Center"/>
                        </Grid>
                        <Canvas x:Name="CanvasRevenue" Height="220" ClipToBounds="True"/>
                        <ItemsControl x:Name="IcBarLabels" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12"
                                               FontFamily="Segoe UI" Foreground="#2E7D32"
                                               HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Room Type Breakdown -->
                <Border Grid.Column="2" Background="White" CornerRadius="14"
                        Padding="22" BorderBrush="#A5D6A7" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Revenue by Room Type" FontSize="15" FontWeight="Bold"
                                   FontFamily="Segoe UI" Foreground="#1B5E20" Margin="0,0,0,16"/>
                        <Canvas x:Name="CanvasPie" Height="180" ClipToBounds="True"/>
                        <ItemsControl x:Name="IcLegend" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Border Width="10" Height="10" CornerRadius="2"
                                                Background="{Binding Color}"
                                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Label}" FontSize="13"
                                                   FontFamily="Segoe UI" Foreground="#2E7D32"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Percent}" FontSize="13"
                                                   FontFamily="Segoe UI" Foreground="#1B5E20"
                                                   FontWeight="Bold" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Phase-Wise Sales Report ── -->
            <Border Background="White" CornerRadius="14" Padding="22"
                    Margin="0,0,0,20" BorderBrush="#A5D6A7" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Phase-Wise Sales" FontSize="15" FontWeight="Bold"
                                       FontFamily="Segoe UI" Foreground="#1B5E20"/>
                            <TextBlock Text="Reservation → Check-in → Check-out → Billed"
                                       FontSize="12" FontFamily="Segoe UI"
                                       Foreground="#81C784" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="GridPhases">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Reservations -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Reservations" FontSize="14" FontWeight="Bold"
                                           FontFamily="Segoe UI" Foreground="#1B5E20"/>
                                <TextBlock Text="Upcoming stays" FontSize="12"
                                           FontFamily="Segoe UI" Foreground="#81C784"/>
                            </StackPanel>
                            <Border Grid.Column="1" Height="28" CornerRadius="6"
                                    Background="#F1F8E9" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Grid>
                                    <Border x:Name="BarReservations" HorizontalAlignment="Left"
                                            Height="28" CornerRadius="6" Background="#A5D6A7"
                                            Width="0"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="TxtPhaseResCount" Grid.Column="2"
                                       FontSize="13" FontWeight="Bold" FontFamily="Segoe UI"
                                       Foreground="#2E7D32" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="0,0,12,0" Text="0 bookings"/>
                            <TextBlock x:Name="TxtPhaseResRev" Grid.Column="3"
                                       FontSize="14" FontWeight="Bold" FontFamily="Segoe UI"
                                       Foreground="#1B5E20" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Text="₹0"/>
                        </Grid>

                        <!-- Active Stays -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Active Stays" FontSize="14" FontWeight="Bold"
                                           FontFamily="Segoe UI" Foreground="#1B5E20"/>
                                <TextBlock Text="Currently in-house" FontSize="12"
                                           FontFamily="Segoe UI" Foreground="#81C784"/>
                            </StackPanel>
                            <Border Grid.Column="1" Height="28" CornerRadius="6"
                                    Background="#F1F8E9" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Grid>
                                    <Border x:Name="BarActive" HorizontalAlignment="Left"
                                            Height="28" CornerRadius="6" Background="#2E7D32"
                                            Width="0"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="TxtPhaseActiveCount" Grid.Column="2"
                                       FontSize="13" FontWeight="Bold" FontFamily="Segoe UI"
                                       Foreground="#2E7D32" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="0,0,12,0" Text="0 guests"/>
                            <TextBlock x:Name="TxtPhaseActiveRev" Grid.Column="3"
                                       FontSize="14" FontWeight="Bold" FontFamily="Segoe UI"
                                       Foreground="#1B5E20" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Text="₹0"/>
                        </Grid>

                        <!-- Checked Out -->
                        <Grid Grid.Row="2" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Checked Out" FontSize="14" FontWeight="Bold"
                                           FontFamily="Segoe UI" Foreground="#1B5E20"/>
                                <TextBlock Text="Completed stays" FontSize="12"
                                           FontFamily="Segoe UI" Foreground="#81C784"/>
                            </StackPanel>
                            <Border Grid.Column="1" Height="28" CornerRadius="6"
                                    Background="#F1F8E9" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Grid>
                                    <Border x:Name="BarCheckedOut" HorizontalAlignment="Left"
                                            Height="28" CornerRadius="6" Background="#81C784"
                                            Width="0"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="TxtPhaseCheckedOutCount" Grid.Column="2"
                                       FontSize="13" FontWeight="Bold" FontFamily="Segoe UI"
                                       Foreground="#2E7D32" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="0,0,12,0" Text="0 stays"/>
                            <TextBlock x:Name="TxtPhaseCheckedOutRev" Grid.Column="3"
                                       FontSize="14" FontWeight="Bold" FontFamily="Segoe UI"
                                       Foreground="#1B5E20" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Text="₹0"/>
                        </Grid>

                        <!-- Billed -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Billed" FontSize="14" FontWeight="Bold"
                                           FontFamily="Segoe UI" Foreground="#1B5E20"/>
                                <TextBlock Text="Invoices raised" FontSize="12"
                                           FontFamily="Segoe UI" Foreground="#81C784"/>
                            </StackPanel>
                            <Border Grid.Column="1" Height="28" CornerRadius="6"
                                    Background="#F1F8E9" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Grid>
                                    <Border x:Name="BarBilled" HorizontalAlignment="Left"
                                            Height="28" CornerRadius="6" Background="#C8E6C9"
                                            Width="0"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="TxtPhaseBilledCount" Grid.Column="2"
                                       FontSize="13" FontWeight="Bold" FontFamily="Segoe UI"
                                       Foreground="#2E7D32" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="0,0,12,0" Text="0 bills"/>
                            <TextBlock x:Name="TxtPhaseBilledRev" Grid.Column="3"
                                       FontSize="14" FontWeight="Bold" FontFamily="Segoe UI"
                                       Foreground="#1B5E20" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Text="₹0"/>
                        </Grid>

                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>