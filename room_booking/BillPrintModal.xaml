<Window x:Class="room_booking.BillPrintModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bill Preview"
        Height="820"  
        Width="620"
        MinHeight="680" MaxHeight="900" MinWidth="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height"          Value="44"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bill Preview (scrollable) -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="28,28,28,8">

            <StackPanel x:Name="PrintArea">

                <!-- ── Hotel Header ── -->
                <Border Background="#0F172A" CornerRadius="14,14,0,0"
                        Padding="28,22,28,22">
                    <Grid>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#EA580C" CornerRadius="6"
                                        Width="12" Height="12"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"/>
                                <TextBlock Text="KMV GRAND INN"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="White"/>
                            </StackPanel>
                            <TextBlock Text=""
                                       FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="77,aringnar Anna Nagar 
Ponnerikarai 
Chennai Bangalore highway 
Kanchipuram 631502  · +91 98843 64908"
                                       FontSize="10" Foreground="#64748B"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Border Background="#EA580C" CornerRadius="8"
                                    Padding="14,6" HorizontalAlignment="Right"
                                    Margin="0,0,0,6">
                                <TextBlock Text="INVOICE" FontSize="11"
                                           FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock x:Name="TxtBillNo"
                                       FontSize="12" Foreground="#64748B"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Orange accent bar ── -->
                <Border Height="5" Background="#EA580C"/>

                <!-- ── Check-in / Check-out strip ── -->
                <Border Background="#0F172A" Padding="28,12,28,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Check-In -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Border Background="#1E293B" CornerRadius="6"
                                    Padding="10,6" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="CHECK-IN" FontSize="9" FontWeight="Bold"
                                               Foreground="#64748B" Margin="0,0,0,3"/>
                                    <TextBlock x:Name="TxtCheckInFull"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Arrow -->
                        <TextBlock Grid.Column="1" Text="→"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#EA580C"
                                   VerticalAlignment="Center"
                                   Margin="12,0"/>

                        <!-- Check-Out -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Border Background="#1E293B" CornerRadius="6"
                                    Padding="10,6">
                                <StackPanel>
                                    <TextBlock Text="CHECK-OUT" FontSize="9" FontWeight="Bold"
                                               Foreground="#64748B" Margin="0,0,0,3"/>
                                    <TextBlock x:Name="TxtCheckOutFull"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Bill meta row (3 columns: Room | Check-Out | Generated) ── -->
                <Border Background="#F8FAFC" Padding="28,16,28,16"
                        BorderBrush="#E2E8F0" BorderThickness="1,0,1,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                            <TextBlock Text="ROOM" FontSize="9" FontWeight="Bold"
                                       Foreground="#94A3B8" Margin="0,0,0,3"/>
                            <TextBlock x:Name="TxtRoomInfo"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="#0F172A"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="CHECK-OUT" FontSize="9" FontWeight="Bold"
                                       Foreground="#94A3B8" Margin="0,0,0,3"/>
                            <TextBlock x:Name="TxtCheckOutDate"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="#0F172A"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <TextBlock Text="GENERATED" FontSize="9" FontWeight="Bold"
                                       Foreground="#94A3B8" Margin="0,0,0,3"/>
                            <TextBlock x:Name="TxtGeneratedTime"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#0F172A"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Guest details card ── -->
                <Border Background="White"
                        BorderBrush="#E2E8F0" BorderThickness="1,0,1,1"
                        Padding="28,18,28,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Border Grid.Column="0"
                                Width="52" Height="52" CornerRadius="26"
                                Background="#EA580C" Margin="0,0,18,0"
                                VerticalAlignment="Top">
                            <TextBlock x:Name="TxtGuestInitial"
                                       Text="?" FontSize="22" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="GUEST DETAILS" FontSize="9"
                                       FontWeight="Bold" Foreground="#94A3B8"
                                       Margin="0,0,0,5"/>
                            <TextBlock x:Name="TxtGuestName"
                                       FontSize="17" FontWeight="Bold"
                                       Foreground="#0F172A" Margin="0,0,0,10"/>

                            <!-- 2×2 detail grid -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtIdTypeLabel"
                                               Text="ID Proof" FontSize="10" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="TxtAadhar" FontSize="12"
                                               FontWeight="SemiBold" Foreground="#0F172A"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Mobile" FontSize="10" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="TxtMobile" FontSize="12"
                                               FontWeight="SemiBold" Foreground="#0F172A"/>
                                </StackPanel>
                                <StackPanel Grid.Column="0" Grid.Row="1">
                                    <TextBlock Text="Address" FontSize="10" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="TxtAddress" FontSize="12"
                                               FontWeight="SemiBold" Foreground="#0F172A"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.Row="1">
                                    <TextBlock Text="Persons" FontSize="10" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="TxtPersons" FontSize="12"
                                               FontWeight="SemiBold" Foreground="#0F172A"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Stay details table ── -->
                <Border Background="White"
                        BorderBrush="#E2E8F0" BorderThickness="1,0,1,1">
                    <StackPanel>
                        <!-- Table header -->
                        <Border Background="#F8FAFC" Padding="28,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DESCRIPTION"
                                           FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Grid.Column="1" Text="CHECK-IN"
                                           FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Grid.Column="2" Text="NIGHTS"
                                           FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="AMOUNT"
                                           FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Border Height="1" Background="#E2E8F0"/>

                        <!-- Table row -->
                        <Border Padding="28,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="TxtRoomDesc"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="#0F172A"/>
                                    <TextBlock x:Name="TxtRoomSubDesc"
                                               FontSize="11" Foreground="#64748B"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="TxtCheckIn"
                                           FontSize="12" Foreground="#0F172A"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="TxtNights"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#0F172A"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" x:Name="TxtLineAmount"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#0F172A"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── Payment summary ── -->
                <Border Background="White"
        BorderBrush="#E2E8F0" BorderThickness="1,0,1,1"
        Padding="28,18,28,18">
                    <StackPanel>


                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Room Service Charges" FontSize="13" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtServiceTotal" FontSize="13"
                       FontWeight="SemiBold" Foreground="#0F172A"
                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Extra Person Charges" FontSize="13" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtExtraPersonTotal" FontSize="13"
                       FontWeight="SemiBold" Foreground="#0F172A"
                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Border Height="1" Background="#E2E8F0" Margin="0,0,0,8"/>

                        

                        <Border Height="1" Background="#E2E8F0" Margin="0,0,0,8"/>

                        <Border Height="1" Background="#E2E8F0" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="CGST (2.5%)" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtCgst" FontSize="12"
                       FontWeight="SemiBold" Foreground="#0F172A"
                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="SGST (2.5%)" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtSgst" FontSize="12"
                       FontWeight="SemiBold" Foreground="#0F172A"
                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Border Height="1" Background="#E2E8F0" Margin="0,4,0,8"/>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Grand Total (incl. tax)" FontSize="13"
                       FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="TxtGrandTotal" FontSize="13"
                       FontWeight="Bold" Foreground="#0F172A"
                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Advance Paid" FontSize="13" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtAdvance" FontSize="13"
                       FontWeight="SemiBold" Foreground="#16A34A"
                       HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Balance Collected -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Balance Collected" FontSize="13"
               Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBalanceCollected" Grid.Column="1"
               FontSize="13" FontWeight="SemiBold"
               Foreground="#0F172A" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Amount Returned (hidden when not applicable) -->
                        <Grid x:Name="AmountReturnedRow" Margin="0,4,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="13" VerticalAlignment="Center">
        <Run Text="Amount Returned" Foreground="#64748B"/>
        <Run Text=" (advance refund)" Foreground="#94A3B8" FontSize="11"/>
                            </TextBlock>
                            <TextBlock x:Name="TxtAmountReturned" Grid.Column="1"
               FontSize="13" FontWeight="SemiBold"
               Foreground="#16A34A" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="#E2E8F0" Margin="0,2,0,14"/>

                        <!-- Balance due box -->
                        <Border x:Name="BalanceBox" Background="#FFF7ED"
                CornerRadius="10" Padding="20,14">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="BALANCE DUE" FontSize="10"
                               FontWeight="Bold" Foreground="#EA580C"/>
                                    <TextBlock x:Name="TxtBalanceNote" FontSize="11"
                               Foreground="#94A3B8" Margin="0,3,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtBalanceDue"
                           FontSize="26" FontWeight="Bold"
                           Foreground="#EA580C"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── Paid stamp (hidden until marked paid) ── -->
                <Border x:Name="PaidStamp" Visibility="Collapsed"
                        Background="#F0FDF4"
                        BorderBrush="#16A34A" BorderThickness="1,0,1,0"
                        Padding="28,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="✔  PAID IN FULL"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#16A34A"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtPaidOn"
                                   FontSize="11" Foreground="#64748B"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ── Terms & Conditions ── -->
                <Border Background="White"
                        BorderBrush="#E2E8F0" BorderThickness="1,0,1,0"
                        Padding="28,16,28,16">
                    <StackPanel>
                        <TextBlock Text="TERMS &amp; CONDITIONS" FontSize="9"
                                   FontWeight="Bold" Foreground="#94A3B8"
                                   Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                   Foreground="#64748B" LineHeight="18">
                            <Run Text="•  Check-out time is 24 hours from the recorded check-in time."/>
                            <LineBreak/>
                            <Run Text="•  A valid government ID was collected at check-in for verification."/>
                            <LineBreak/>
                            <Run Text="•  Management is not responsible for loss of cash or valuables left unattended in the room."/>
                            <LineBreak/>
                            <Run Text="•  Any damage to room property will be charged separately."/>
                            <LineBreak/>
                            <Run Text="•  This is a computer-generated bill and does not require a physical signature for validity."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ── Signature row ── -->
                <Border Background="White"
                        BorderBrush="#E2E8F0" BorderThickness="1,0,1,0"
                        Padding="28,20,28,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Height="1" Background="#CBD5E1" Margin="0,0,0,6"/>
                            <TextBlock Text="Guest Signature" FontSize="10"
                                       Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border Height="1" Background="#CBD5E1" Margin="0,0,0,6"/>
                            <TextBlock Text="Authorized By" FontSize="10"
                                       Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Thank you footer ── -->
                <Border Background="#0F172A" CornerRadius="0,0,14,14"
                        Padding="20,16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Thank you for Visiting 🙏"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="KMV GRAND INN"
                                   FontSize="10" Foreground="#94A3B8"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>
                        <TextBlock Text="77,aringnar Anna Nagar 
Ponnerikarai 
Chennai Bangalore highway 
Kanchipuram 631502  · +91 98843 64908"
                                   FontSize="9" Foreground="#475569"
                                   HorizontalAlignment="Center"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Action bar ── -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="✕  Close"
                        Style="{StaticResource ActionBtn}"
                        Background="#F1F5F9"
                        Foreground="#64748B"
                        Click="Close_Click"/>

                <Button Grid.Column="2"
                        x:Name="BtnMarkPaid"
                        Content="✔  Mark as Paid &amp; Print"
                        Style="{StaticResource ActionBtn}"
                        Background="#16A34A"
                        Foreground="White"
                        Click="MarkPaid_Click"/>

                <Button Grid.Column="2"
                        x:Name="BtnPrintOnly"
                        Content="🖨  Print Bill"
                        Visibility="Collapsed"
                        Style="{StaticResource ActionBtn}"
                        Background="#EA580C"
                        Foreground="White"
                        Click="PrintOnly_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
