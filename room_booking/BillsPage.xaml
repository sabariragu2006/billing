<Page x:Class="room_booking.BillsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F1F8E9"
      FontFamily="Segoe UI">

    <Page.Resources>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#C8E6C9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Margin"          Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F8E9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C8E6C9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="#1B5E20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#1B5E20"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#A5D6A7"/>
            <Setter Property="Foreground"      Value="#1B5E20"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Padding"         Value="12,11"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush"     Value="#2E7D32"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Height"                   Value="40"/>
            <Setter Property="Padding"                  Value="14,0"/>
            <Setter Property="FontSize"                 Value="14"/>
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="BorderBrush"              Value="#A5D6A7"/>
            <Setter Property="BorderThickness"          Value="1.5"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#1B5E20"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2E7D32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageBtn" TargetType="Button">
            <Setter Property="Height"          Value="38"/>
            <Setter Property="Width"           Value="100"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush"     Value="#A5D6A7"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#1B5E20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C8E6C9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="28,24,28,40">
            <StackPanel>

                <!-- ── Page header ── -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧾" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bills " FontSize="22" FontWeight="Bold"
                                           Foreground="#1B5E20" FontFamily="Segoe UI"/>
                                <TextBlock Text="History" FontSize="22" FontWeight="Bold"
                                           Foreground="#2E7D32" FontFamily="Segoe UI"/>
                            </StackPanel>
                            <TextBlock Text="All checked-out guest invoices"
                                       FontSize="12" Foreground="#81C784" FontFamily="Segoe UI"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Summary chips -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="White" BorderBrush="#A5D6A7" BorderThickness="1.5"
                                CornerRadius="10" Padding="16,10" Margin="0,0,10,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="TOTAL BILLS" FontSize="10" FontWeight="Bold"
                                           Foreground="#81C784" FontFamily="Segoe UI"
                                           HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                <TextBlock x:Name="ChipTotal" Text="0" FontSize="20"
                                           FontWeight="Bold" Foreground="#1B5E20"
                                           FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#C8E6C9" BorderBrush="#2E7D32" BorderThickness="1.5"
                                CornerRadius="10" Padding="16,10">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="GST Included Revenue" FontSize="10" FontWeight="Bold"
                                           Foreground="#2E7D32" FontFamily="Segoe UI"
                                           HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                <TextBlock x:Name="ChipRevenue" Text="₹0" FontSize="20"
                                           FontWeight="Bold" Foreground="#1B5E20"
                                           FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ── Toolbar ── -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox x:Name="TxtSearch"
                                 Style="{StaticResource SearchBox}"
                                 TextChanged="TxtSearch_TextChanged"
                                 ToolTip="Search by name, room, bill number or mobile"/>
                        <TextBlock Text="🔍  Search by name, room, bill no, mobile…"
                                   Foreground="#81C784" FontSize="13" FontFamily="Segoe UI"
                                   Margin="14,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ComboBox Grid.Column="2" x:Name="CmbFilter"
                              Height="40" FontSize="13" FontFamily="Segoe UI"
                              BorderBrush="#A5D6A7" BorderThickness="1.5"
                              Foreground="#1B5E20" VerticalContentAlignment="Center"
                              SelectionChanged="CmbFilter_SelectionChanged">
                        <ComboBoxItem Content="All Time" IsSelected="True"/>
                        <ComboBoxItem Content="Today"/>
                        <ComboBoxItem Content="This Week"/>
                        <ComboBoxItem Content="This Month"/>
                    </ComboBox>

                    <Button Grid.Column="4" Content="↻  Refresh"
                            Style="{StaticResource ActionBtn}"
                            Background="#2E7D32" Foreground="White"
                            Width="110" Click="BtnRefresh_Click"/>
                </Grid>

                <!-- ── Bills table ── -->
                <Border Background="White" CornerRadius="14"
                        BorderBrush="#A5D6A7" BorderThickness="1.5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2"
                                          Color="#000000" Opacity="0.06"/>
                    </Border.Effect>

                    <DataGrid x:Name="BillsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserResizeRows="False"
                              IsReadOnly="True" SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E8F5E9"
                              BorderThickness="0" Background="White"
                              RowStyle="{StaticResource GridRowStyle}"
                              CellStyle="{StaticResource GridCellStyle}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              RowHeaderWidth="0" MinHeight="200">

                        <DataGrid.Columns>

                            <!-- BILL NO -->
                            <DataGridTemplateColumn Header="BILL NO" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#E8F5E9" CornerRadius="8" Padding="8,5">
                                            <TextBlock Text="{Binding BillNoFormatted}"
                                                       FontSize="12" FontWeight="Bold"
                                                       FontFamily="Segoe UI" Foreground="#1B5E20"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- GUEST -->
                            <DataGridTemplateColumn Header="GUEST" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="34" Height="34" CornerRadius="17"
                                                    Background="#2E7D32" Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GuestInitial}"
                                                           FontSize="13" FontWeight="Bold"
                                                           FontFamily="Segoe UI" Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GuestName}"
                                                           FontSize="13" FontWeight="Bold"
                                                           FontFamily="Segoe UI" Foreground="#1B5E20"/>
                                                <TextBlock Text="{Binding Mobile}"
                                                           FontSize="11" FontFamily="Segoe UI"
                                                           Foreground="#81C784" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ROOM & STAY -->
                            <DataGridTemplateColumn Header="ROOM  &amp;  STAY" Width="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#C8E6C9" CornerRadius="5"
                                                        Padding="7,2" Margin="0,0,7,0">
                                                    <TextBlock Text="{Binding RoomNumber}"
                                                               FontSize="12" FontWeight="Bold"
                                                               FontFamily="Segoe UI" Foreground="#1B5E20"/>
                                                </Border>
                                                <TextBlock Text="{Binding RoomType}"
                                                           FontSize="12" FontFamily="Segoe UI"
                                                           Foreground="#2E7D32" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding StayRange}"
                                                       FontSize="11" FontFamily="Segoe UI"
                                                       Foreground="#4CAF50" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding DaysLabel}"
                                                       FontSize="11" FontFamily="Segoe UI"
                                                       Foreground="#81C784" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- TOTAL AMOUNT -->
                            <DataGridTemplateColumn Header="TOTAL AMOUNT" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalFormatted}"
                                                       FontSize="16" FontWeight="Bold"
                                                       FontFamily="Segoe UI" Foreground="#1B5E20"/>
                                            <TextBlock Text="incl. GST (5%)"
                                                       FontSize="10" FontFamily="Segoe UI"
                                                       Foreground="#81C784" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- STATUS -->
                            <DataGridTemplateColumn Header="STATUS" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="10,6"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFF3E0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BalanceFormatted}" Value="PAID ✓">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding BalanceFormatted}"
                                                           FontSize="12" FontWeight="Bold"
                                                           FontFamily="Segoe UI">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#EA580C"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BalanceFormatted}" Value="PAID ✓">
                                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock FontSize="10" FontFamily="Segoe UI"
                                                           Foreground="#81C784" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="balance due"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BalanceFormatted}" Value="PAID ✓">
                                                                    <Setter Property="Text" Value="fully settled"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- VIEW BILL -->
                            <DataGridTemplateColumn Header="" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🧾 View"
                                                Style="{StaticResource ActionBtn}"
                                                Background="#2E7D32" Foreground="White"
                                                Tag="{Binding}"
                                                Click="PrintBill_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Style.Triggers>
                                    <Trigger Property="HasItems" Value="False">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <Border Background="White" CornerRadius="14" Padding="0,60">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="🧾" FontSize="44"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,0,0,14"/>
                                                            <TextBlock Text="No bills yet"
                                                                       FontSize="18" FontWeight="Bold"
                                                                       FontFamily="Segoe UI" Foreground="#1B5E20"
                                                                       HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Bills will appear here after guests check out."
                                                                       FontSize="13" FontFamily="Segoe UI"
                                                                       Foreground="#81C784"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,8,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>

                    </DataGrid>
                </Border>

                <!-- ── Pagination bar ── -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnPrev" Grid.Column="0" Content="← Prev"
                            Style="{StaticResource PageBtn}" Click="BtnPrev_Click"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPageInfo" Text="Page 1 of 1"
                                   FontSize="13" FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="#2E7D32" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtPageCount" Text=""
                                   FontSize="13" FontFamily="Segoe UI" Foreground="#81C784"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="BtnNext" Grid.Column="2" Content="Next →"
                            Style="{StaticResource PageBtn}" Click="BtnNext_Click"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Toast -->
        <Border x:Name="ToastBar" Background="#1B5E20" CornerRadius="999"
                Padding="22,12" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,28" Visibility="Collapsed" Panel.ZIndex="100">
            <TextBlock x:Name="ToastText" Foreground="White"
                       FontSize="14" FontWeight="Bold" FontFamily="Segoe UI"/>
        </Border>
    </Grid>
</Page>