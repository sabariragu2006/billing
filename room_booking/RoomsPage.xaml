<Page x:Class="room_booking.RoomsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFF7ED">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="🛏️ Rooms"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#431407"/>

            <TextBlock Text="Manage all hotel rooms here"
                       Margin="0,5,0,20"
                       Foreground="#C2410C"/>

            <WrapPanel>
                <Border Width="180"
                        Height="120"
                        Background="White"
                        CornerRadius="12"
                        Margin="0,0,15,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="101"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Available"
                                   Foreground="Green"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Width="180"
                        Height="120"
                        Background="White"
                        CornerRadius="12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="102"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Occupied"
                                   Foreground="Red"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Page>