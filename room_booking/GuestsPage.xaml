<Page x:Class="room_booking.GuestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F1F8E9"
      FontFamily="Segoe UI">

    <Page.Resources>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Height"                   Value="42"/>
            <Setter Property="Padding"                  Value="14,0"/>
            <Setter Property="FontSize"                 Value="15"/>
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="BorderBrush"              Value="#A5D6A7"/>
            <Setter Property="BorderThickness"          Value="1.5"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#1B5E20"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2E7D32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterBtn" TargetType="Button">
            <Setter Property="Height"          Value="42"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageBtn" TargetType="Button">
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Width"           Value="105"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush"     Value="#A5D6A7"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#1B5E20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C8E6C9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="28,24,28,40">
            <StackPanel>

                <!-- ── Header ── -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="👥" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Guest " FontSize="26" FontWeight="Bold"
                                   Foreground="#1B5E20" VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text="Directory" FontSize="26" FontWeight="Bold"
                                   Foreground="#2E7D32" VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                </Grid>

                <!-- ── Toolbar: search + filter buttons ── -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <Grid Grid.Column="0">
                        <TextBox x:Name="TxtSearch"
                                 Style="{StaticResource SearchBox}"
                                 TextChanged="TxtSearch_TextChanged"/>
                        <TextBlock Text="🔍  Search by name, mobile or Aadhaar…"
                                   Foreground="#558B2F" FontSize="15"
                                   FontFamily="Segoe UI"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Filter buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnFilterAll"
            Content="All"
            Style="{StaticResource FilterBtn}"
            Margin="0,0,8,0" Width="80"
            Click="BtnFilterAll_Click"/>
                        <Button x:Name="BtnFilterActive"
            Content="Active"
            Style="{StaticResource FilterBtn}"
            Margin="0,0,8,0" Width="100"
            Click="BtnFilterActive_Click"/>
                        <Button x:Name="BtnFilterOut"
            Content="Checked Out"
            Style="{StaticResource FilterBtn}"
            Width="140"
            Click="BtnFilterOut_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ── Guest cards ── -->
                <StackPanel x:Name="GuestListPanel"/>

                <!-- ── Pagination bar ── -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnPrev"
                            Grid.Column="0"
                            Content="← Prev"
                            Style="{StaticResource PageBtn}"
                            Click="BtnPrev_Click"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPageInfo"
                                   Text="Page 1 of 1"
                                   FontSize="14" FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   Foreground="#2E7D32"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtPageCount"
                                   Text=""
                                   FontSize="14" FontFamily="Segoe UI"
                                   Foreground="#558B2F"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="BtnNext"
                            Grid.Column="2"
                            Content="Next →"
                            Style="{StaticResource PageBtn}"
                            Click="BtnNext_Click"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Toast -->
        <Border x:Name="ToastBar"
                Background="#1B5E20" CornerRadius="999"
                Padding="22,12"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,28"
                Visibility="Collapsed"
                Panel.ZIndex="100">
            <TextBlock x:Name="ToastText" Foreground="White"
                       FontSize="14" FontWeight="Bold"
                       FontFamily="Segoe UI"/>
        </Border>
    </Grid>
</Page>
