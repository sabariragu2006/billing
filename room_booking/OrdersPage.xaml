<Page x:Class="room_booking.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F1F8E9"
      FontFamily="Segoe UI">

    <Page.Resources>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#C8E6C9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Margin"          Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F8E9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C8E6C9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Foreground"      Value="#1B5E20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#1B5E20"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"                 Value="#A5D6A7"/>
            <Setter Property="Foreground"                 Value="#1B5E20"/>
            <Setter Property="FontSize"                   Value="12"/>
            <Setter Property="FontWeight"                 Value="Bold"/>
            <Setter Property="FontFamily"                 Value="Segoe UI"/>
            <Setter Property="Padding"                    Value="12,10"/>
            <Setter Property="BorderThickness"            Value="0,0,0,2"/>
            <Setter Property="BorderBrush"                Value="#2E7D32"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="GridHeaderCenter" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource GridHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridHeaderRight" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource GridHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Height"                   Value="40"/>
            <Setter Property="Padding"                  Value="14,0"/>
            <Setter Property="FontSize"                 Value="14"/>
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="BorderBrush"              Value="#A5D6A7"/>
            <Setter Property="BorderThickness"          Value="1.5"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#1B5E20"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2E7D32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageBtn" TargetType="Button">
            <Setter Property="Height"          Value="38"/>
            <Setter Property="Width"           Value="100"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush"     Value="#A5D6A7"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#1B5E20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C8E6C9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="28,24,28,40">
            <StackPanel>

                <!-- ── Page header ── -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🍽️" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Active " FontSize="24" FontWeight="Bold"
                                   Foreground="#1B5E20" VerticalAlignment="Center"/>
                        <TextBlock Text="Guests" FontSize="24" FontWeight="Bold"
                                   Foreground="#2E7D32" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="White" BorderBrush="#A5D6A7" BorderThickness="1.5"
                                CornerRadius="999" Padding="14,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Active Stays: " FontSize="13" Foreground="#2E7D32"/>
                                <TextBlock x:Name="ChipActive" Text="0" FontSize="13"
                                           FontWeight="Bold" Foreground="#1B5E20"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#A5D6A7" BorderThickness="1.5"
                                CornerRadius="999" Padding="14,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Guests: " FontSize="13" Foreground="#2E7D32"/>
                                <TextBlock x:Name="ChipPersons" Text="0" FontSize="13"
                                           FontWeight="Bold" Foreground="#1B5E20"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#C8E6C9" BorderBrush="#2E7D32" BorderThickness="1.5"
                                CornerRadius="999" Padding="14,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Total Billed: " FontSize="13" Foreground="#2E7D32"/>
                                <TextBlock x:Name="ChipTotal" Text="₹0" FontSize="13"
                                           FontWeight="Bold" Foreground="#1B5E20"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFCDD2" BorderBrush="#B71C1C" BorderThickness="1.5"
                                CornerRadius="999" Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Balance Due: " FontSize="13" Foreground="#B71C1C"/>
                                <TextBlock x:Name="ChipBalance" Text="₹0" FontSize="13"
                                           FontWeight="Bold" Foreground="#B71C1C"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ── Toolbar ── -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox x:Name="TxtSearch"
                                 Style="{StaticResource SearchBox}"
                                 TextChanged="TxtSearch_TextChanged"
                                 ToolTip="Search by guest name, room, or mobile"/>
                        <TextBlock Text="🔍  Search active guests…"
                                   Foreground="#81C784" FontSize="14"
                                   Margin="14,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ComboBox Grid.Column="2" x:Name="CmbFilter"
                              Height="40" FontSize="14"
                              BorderBrush="#A5D6A7" BorderThickness="1.5"
                              Foreground="#1B5E20"
                              VerticalContentAlignment="Center"
                              SelectionChanged="CmbFilter_SelectionChanged">
                        <ComboBoxItem Content="All Floors" IsSelected="True"/>
                        <ComboBoxItem Content="Floor 1"/>
                        <ComboBoxItem Content="Floor 2"/>
                        <ComboBoxItem Content="Floor 3"/>
                    </ComboBox>

                    <Button Grid.Column="4"
                            Content="↻  Refresh"
                            Style="{StaticResource ActionBtn}"
                            Background="#2E7D32" Foreground="White"
                            Width="110"
                            Click="BtnRefresh_Click"/>
                </Grid>

                <!-- ── Active stays table ── -->
                <Border Background="White" CornerRadius="14"
                        BorderBrush="#A5D6A7" BorderThickness="1.5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2"
                                          Color="#000000" Opacity="0.06"/>
                    </Border.Effect>

                    <DataGrid x:Name="OrdersGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserResizeRows="False"
                              IsReadOnly="True" SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#C8E6C9"
                              BorderThickness="0" Background="White"
                              RowStyle="{StaticResource GridRowStyle}"
                              CellStyle="{StaticResource GridCellStyle}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              RowHeaderWidth="0" MinHeight="200">

                        <DataGrid.Columns>

                            <!-- GUEST -->
                            <DataGridTemplateColumn Header="GUEST" Width="*"
                                HeaderStyle="{StaticResource GridHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="36" Height="36" CornerRadius="18"
                                                    Background="#2E7D32" Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GuestInitial}"
                                                           FontSize="14" FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GuestName}"
                                                           FontSize="14" FontWeight="Bold"
                                                           Foreground="#1B5E20"/>
                                                <TextBlock Text="{Binding Mobile}"
                                                           FontSize="12" Foreground="#81C784"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ROOM -->
                            <DataGridTemplateColumn Header="ROOM" Width="100"
                                HeaderStyle="{StaticResource GridHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding RoomLabel}"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="#1B5E20"/>
                                            <TextBlock Text="{Binding RoomType}"
                                                       FontSize="12" Foreground="#81C784"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- STAY -->
                            <DataGridTemplateColumn Header="STAY" Width="190"
                                HeaderStyle="{StaticResource GridHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding StayRange}"
                                                       FontSize="13" Foreground="#1B5E20"/>
                                            <TextBlock Text="{Binding DaysLabel}"
                                                       FontSize="12" Foreground="#81C784"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- PERSONS -->
                            <DataGridTemplateColumn Header="PERSONS" Width="80"
                                HeaderStyle="{StaticResource GridHeaderCenter}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Persons}"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="#1B5E20"
                                                   HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- TOTAL -->
                            <DataGridTemplateColumn Header="TOTAL" Width="110"
                                HeaderStyle="{StaticResource GridHeaderRight}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalFormatted}"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="#1B5E20"
                                                   HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ADVANCE -->
                            <DataGridTemplateColumn Header="ADVANCE" Width="110"
                                HeaderStyle="{StaticResource GridHeaderRight}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AdvanceFormatted}"
                                                   FontSize="14" FontWeight="Bold"
                                                   Foreground="#2E7D32"
                                                   HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- BALANCE -->
                            <DataGridTemplateColumn Header="BALANCE" Width="120"
                                HeaderStyle="{StaticResource GridHeaderCenter}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="10,5"
                                                Background="{Binding BalanceBg}"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding BalanceFormatted}"
                                                       FontSize="13" FontWeight="Bold"
                                                       Foreground="{Binding BalanceFg}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- STATUS -->
                            <DataGridTemplateColumn Header="STATUS" Width="100"
                                HeaderStyle="{StaticResource GridHeaderCenter}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#C8E6C9" CornerRadius="8" Padding="10,5"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="🟢 Active"
                                                       FontSize="13" FontWeight="Bold"
                                                       Foreground="#1B5E20"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Style.Triggers>
                                    <Trigger Property="HasItems" Value="False">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <Border Background="White" CornerRadius="14" Padding="0,60">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="🍽️" FontSize="44"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,0,0,14"/>
                                                            <TextBlock Text="No active guests"
                                                                       FontSize="18" FontWeight="Bold"
                                                                       Foreground="#1B5E20"
                                                                       HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Checked-in guests will appear here."
                                                                       FontSize="14" Foreground="#81C784"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,8,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>

                    </DataGrid>
                </Border>

                <!-- ── Pagination bar ── -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnPrev" Grid.Column="0"
                            Content="← Prev" Style="{StaticResource PageBtn}"
                            Click="BtnPrev_Click"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPageInfo" Text="Page 1 of 1"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="#2E7D32" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtPageCount" Text=""
                                   FontSize="13" Foreground="#81C784"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="BtnNext" Grid.Column="2"
                            Content="Next →" Style="{StaticResource PageBtn}"
                            Click="BtnNext_Click"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Toast -->
        <Border x:Name="ToastBar"
                Background="#1B5E20" CornerRadius="999"
                Padding="22,12"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,28" Visibility="Collapsed" Panel.ZIndex="100">
            <TextBlock x:Name="ToastText" Foreground="White"
                       FontSize="14" FontWeight="Bold"/>
        </Border>
    </Grid>
</Page>