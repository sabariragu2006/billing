<UserControl x:Class="room_booking.NavBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="290">

    <UserControl.Resources>

        <DropShadowEffect x:Key="SidebarShadow" BlurRadius="20" ShadowDepth="3"
                          Direction="0" Color="#000000" Opacity="0.18"/>

        <Style x:Key="NavBtnActive" TargetType="Button">
            <Setter Property="Background"                 Value="#2E7D32"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                    Value="14,12"/>
            <Setter Property="Margin"                     Value="8,2"/>
            <Setter Property="FontSize"                   Value="15"/>
            <Setter Property="FontWeight"                 Value="Bold"/>
            <Setter Property="FontFamily"                 Value="Segoe UI"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Width="6" Height="6" CornerRadius="3"
                                        Background="White" Opacity="0.9"
                                        VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavBtnIdle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                    Value="14,12"/>
            <Setter Property="Margin"                     Value="8,2"/>
            <Setter Property="FontSize"                   Value="15"/>
            <Setter Property="FontWeight"                 Value="Bold"/>
            <Setter Property="FontFamily"                 Value="Segoe UI"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E7D32"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B5E20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarScrollBar" TargetType="ScrollBar">
            <Setter Property="Width"      Value="3"/>
            <Setter Property="MinWidth"   Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#81C784" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar Grid.Column="1"
                                       x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource SidebarScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border Background="#1B5E20"
            Effect="{StaticResource SidebarShadow}"
            Panel.ZIndex="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- branding + nav (scrollable) -->
                <RowDefinition Height="Auto"/>
                <!-- version footer — always pinned -->
            </Grid.RowDefinitions>

            <!-- ══ BRANDING + NAV (SCROLLABLE) ════════════════════════════ -->
            <ScrollViewer Grid.Row="0"
                          Style="{StaticResource SidebarScrollViewer}"
                          PanningMode="VerticalOnly">
                <StackPanel>

                    <!-- ── Top branding bar — same green, seamlessly merged ── -->
                    <Border Background="#1B5E20"
                            CornerRadius="0"
                            Padding="16,22,16,18"
                            Margin="0,0,0,0">
                        <StackPanel>

                            <!-- Logo + name row -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <!-- Hotel icon in light green circle -->
                                <Border Background="#A5D6A7" CornerRadius="14"
                                        Width="52" Height="52" Margin="0,0,14,0">
                                    <TextBlock Text="🏨" FontSize="26"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="KMV GRAND INN"
                                               Foreground="#C8E6C9"
                                               FontSize="15" FontWeight="Bold"
                                               FontFamily="Segoe UI"/>
                                    <TextBlock Text="Room Manager"
                                               Foreground="#81C784"
                                               FontSize="11" FontWeight="Bold"
                                               FontFamily="Segoe UI"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- LIVE pill in light green -->
                            

                        </StackPanel>
                    </Border>

                    <!-- ── Section label ── -->
                    <TextBlock Text="MAIN MENU"
                               Foreground="#81C784"
                               FontSize="11" FontWeight="Bold"
                               FontFamily="Segoe UI"
                               Margin="22,18,0,6"/>

                    <!-- ── Nav Buttons ── -->
                    <StackPanel Margin="0,0,0,16">

                        <Button x:Name="BtnDashboard"
                                Style="{StaticResource NavBtnIdle}"
                                Click="BtnDashboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="17" VerticalAlignment="Center" Width="28"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnRoomAllocation"
                                Style="{StaticResource NavBtnIdle}"
                                Click="BtnRoomAllocation_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛏️" FontSize="17" VerticalAlignment="Center" Width="28"/>
                                <TextBlock Text="Room Allocation" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnOrders"
                                Style="{StaticResource NavBtnIdle}"
                                Click="BtnOrders_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🍽️" FontSize="17" VerticalAlignment="Center" Width="28"/>
                                <TextBlock Text="Orders" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSales"
                                Style="{StaticResource NavBtnIdle}"
                                Click="BtnSales_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📈" FontSize="17" VerticalAlignment="Center" Width="28"/>
                                <TextBlock Text="Sales Report" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnReservation"
                                Style="{StaticResource NavBtnIdle}"
                                Click="BtnReservation_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅" FontSize="17" VerticalAlignment="Center" Width="28"/>
                                <TextBlock Text="Room Reservation" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnGuests"
                                Style="{StaticResource NavBtnIdle}"
                                Click="BtnGuests_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" FontSize="17" VerticalAlignment="Center" Width="28"/>
                                <TextBlock Text="Guests" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnBills"
                                Style="{StaticResource NavBtnIdle}"
                                Click="BtnBills_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧾" FontSize="17" VerticalAlignment="Center" Width="28"/>
                                <TextBlock Text="Bills" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- ══ VERSION FOOTER — always pinned at bottom ══════════════ -->
            <Border Grid.Row="1"
                    Background="#0A3D0A"
                    CornerRadius="14,14,0,0"
                    Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="#2E7D32" CornerRadius="8"
                            Padding="10,5" Margin="0,0,12,0">
                        <TextBlock Text="v 1.0" FontSize="11" FontWeight="Bold"
                                   Foreground="White" FontFamily="Segoe UI"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Room Booking"
                                   Foreground="#81C784"
                                   FontSize="13" FontWeight="Bold"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text="KMV Grand Inn"
                                   Foreground="#2E7D32"
                                   FontSize="11" FontFamily="Segoe UI"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>