<Page x:Class="room_booking.RoomAllocationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F0FFF0"
      FontFamily="Segoe UI">

    <Page.Resources>

        <!-- ── Room Card Button ── -->
        <Style x:Key="RoomCardStyle" TargetType="Button">
            <Setter Property="Background"      Value="#A5D6A7"/>
            <Setter Property="BorderBrush"     Value="#388E3C"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="14,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="2"
                                                  Color="#000000" Opacity="0.12"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#81C784"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1B5E20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Modal Action Button ── -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#1B5E20"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E7D32"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#145214"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#A5D6A7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Danger Button ── -->
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background"      Value="#FFCDD2"/>
            <Setter Property="Foreground"      Value="#B71C1C"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush"     Value="#E53935"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EF9A9A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TextBox ── -->
        <Style x:Key="FormField" TargetType="TextBox">
            <Setter Property="Height"                   Value="40"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="FontSize"                 Value="15"/>
            <Setter Property="BorderBrush"              Value="#388E3C"/>
            <Setter Property="BorderThickness"          Value="2"/>
            <Setter Property="Background"               Value="#FFFFFF"/>
            <Setter Property="Foreground"               Value="#000000"/>
            <Setter Property="FontWeight"               Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1B5E20"/>
                                <Setter TargetName="Bd" Property="Background"  Value="#F1F8E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>
        <!-- ── Scrollable main content ── -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="28,24,28,80">
            <StackPanel>

                <!-- Header row -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🏨" FontSize="26" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Room "     FontSize="26" FontWeight="Bold"
                                   Foreground="#1B5E20" VerticalAlignment="Center"/>
                        <TextBlock Text="Allocation" FontSize="26" FontWeight="Bold"
                                   Foreground="#388E3C" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Stat chips -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#C8E6C9" BorderBrush="#2E7D32" BorderThickness="2"
                                CornerRadius="999" Padding="12,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="#1B5E20"
                                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock x:Name="ChipEmpty" Text="0 Available"
                                           FontSize="13" FontWeight="Bold" Foreground="#1B5E20"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFCDD2" BorderBrush="#D32F2F" BorderThickness="2"
                                CornerRadius="999" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="#B71C1C"
                                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock x:Name="ChipFull" Text="0 Occupied"
                                           FontSize="13" FontWeight="Bold" Foreground="#B71C1C"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Legend -->
                <Border Background="#A5D6A7" BorderBrush="#2E7D32" BorderThickness="2"
                        CornerRadius="10" Padding="16,10" Margin="0,0,0,22">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                            <Border Width="18" Height="18" CornerRadius="4"
                                    Background="#C8E6C9" BorderBrush="#1B5E20"
                                    BorderThickness="2.5" Margin="0,0,8,0"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="Available" FontSize="13" FontWeight="Bold"
                                       Foreground="#1B5E20" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="18" Height="18" CornerRadius="4"
                                    Background="#FFCDD2" BorderBrush="#C62828"
                                    BorderThickness="2.5" Margin="0,0,8,0"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="Occupied" FontSize="13" FontWeight="Bold"
                                       Foreground="#B71C1C" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Room grid -->
                <StackPanel x:Name="RoomsPanel"/>

            </StackPanel>
        </ScrollViewer>

        <!-- ══════════════════════════════════════
             MODAL OVERLAY - FULL PAGE
        ══════════════════════════════════════ -->
        <Grid x:Name="ModalOverlay" Visibility="Collapsed" Panel.ZIndex="100"
              Background="#E8F5E9">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Modal header -->
                <Border Grid.Row="0" Background="#1B5E20" Padding="24,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Room " FontSize="20" FontWeight="Bold"
                                       Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ModalRoomNumber" Text="—"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="#A5D6A7" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ModalRoomMeta" Text=""
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="#C8E6C9"
                                       Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕"
                                Style="{StaticResource DangerBtn}"
                                Background="#C62828" Foreground="White"
                                BorderThickness="0"
                                Click="CloseModal_Click"
                                Width="32" Height="32"
                                FontSize="14" FontWeight="Bold"/>
                    </Grid>
                </Border>

                <!-- Modal body -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="20,14,20,14"
                              Background="#E8F5E9">
                    <StackPanel x:Name="ModalBody"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Toast -->
        <Border x:Name="ToastBar"
                Background="#1B5E20"
                BorderBrush="#A5D6A7"
                BorderThickness="1.5"
                CornerRadius="999"
                Padding="24,12"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,28"
                Visibility="Collapsed"
                Panel.ZIndex="200">
            <TextBlock x:Name="ToastText" Foreground="White"
                       FontSize="14" FontWeight="Bold"/>
        </Border>
    </Grid>
</Page>